{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "findpitches-uk-acquisition-canary",
  "main": "src/index.js",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "limits": {
    "cpu_ms": 300000
  },
  "observability": {
    "enabled": true
  },
  "workflows": [
    {
      "name": "findpitches-uk-acquisition-canary",
      "binding": "UK_ACQUISITION_CANARY",
      "class_name": "UkCloudflareCanaryWorkflow"
    }
  ]
}
