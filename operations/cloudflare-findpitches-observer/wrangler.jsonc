{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "findpitches-observer",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "findpitches-observer",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
