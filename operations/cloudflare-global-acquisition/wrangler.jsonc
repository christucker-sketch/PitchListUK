{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "findpitches-global-acquisition-shadow",
  "main": "src/index.js",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "limits": {
    "cpu_ms": 300000
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "workflows": [
    {
      "name": "findpitches-global-acquisition-shadow",
      "binding": "GLOBAL_ACQUISITION",
      "class_name": "GlobalAcquisitionWorkflow"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CONTROLLER_STATE",
        "class_name": "ControllerStateDurableObject"
      },
      {
        "name": "UK_CONTROLLER_STATE",
        "class_name": "UkControllerStateDurableObject"
      },
      {
        "name": "CA_CONTROLLER_STATE",
        "class_name": "CaControllerStateDurableObject"
      }
    ]
  },
  "exports": {
    "ControllerStateDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "UkControllerStateDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "CaControllerStateDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "services": [
    {
      "binding": "SERPER_BROKER",
      "service": "pitchlist-texas-acquisition"
    },
    {
      "binding": "GITHUB_PR_BROKER",
      "service": "pitchlist-texas-acquisition"
    }
  ],
  "vars": {
    "GITHUB_REPO": "christucker-sketch/PitchListUK",
    "GLOBAL_ACQUISITION_EXECUTION_ENABLED": "true",
    "GLOBAL_ACQUISITION_EXECUTION_LEVEL": "production",
    "GLOBAL_CONTROLLER_CUTOVER_ENABLED": "true",
    "GLOBAL_UK_CONTROLLER_CUTOVER_ENABLED": "true",
    "GLOBAL_CA_CONTROLLER_CUTOVER_ENABLED": "true"
  }
}
