#!/usr/bin/env bash
# mycnotify — Mycelium Stage C approval notices (PROPOSAL; not installed until Codex review + Chris's go-ahead).
# Reads the public hub anonymously (no GitHub credential), finds tasks whose folded state is awaiting_approval, and
# emails ONE plain-text notice per decision through SMTP2GO, using a dedicated FindPitches-only key and sender.
# It never writes to GitHub, never approves anything, never starts an agent, and shares nothing with hubsync.
#   mycnotify poll       one run (the timer runs it every 5 minutes)
#   mycnotify baseline   record every decision outstanding NOW as already handled (no send); required before live
#   mycnotify release    clear the global hold set by a provider auth/config refusal (after fixing the config)
#   mycnotify decisions  list the decisions outstanding now, with their keys and ledger state (read-only)
#   mycnotify status     print status
# Safety model (Stage C): decision key = task id + awaiting event seq + event blob (+ descriptor blob in the record).
# A local write-ahead ledger records a CLAIM before the HTTP request; an interrupted claim becomes "uncertain" and is
# never resent. Only definitely-not-accepted failures retry (no connection; HTTP 429), at most 3 attempts. Timeouts,
# 5xx and lost responses are "uncertain": no resend. A totally missing ledger blocks live sending until `baseline`,
# which deliberately suppresses what is outstanding (a missed notice, not a duplicate). Partial ledger deletion or
# restoring an old ledger copy is NOT covered and could resend. Mode is root-controlled (MODE= in the credential
# config); anything other than MODE=live is a dry run that never calls the mail API. Stage C live is PINNED: it admits
# only the one decision named by PIN= (no PIN => live refused). Every HTTP attempt, retries included, is appended to a
# per-London-day attempt log before the request, and the daily cap counts those attempts.
set -euo pipefail
shopt -s inherit_errexit
umask 077

: "${MYCNOTIFY_HOME:=/var/lib/mycnotify}"
: "${MYCNOTIFY_REMOTE:=https://github.com/christucker-sketch/PitchListUK.git}"
: "${MYCNOTIFY_BRANCH:=findpitches-v3/greenfield}"
: "${MYCNOTIFY_TASKS:=greenfield/mycelium/tasks}"   # the real task path (the Stage C proof used notify-test/tasks)
: "${MYCNOTIFY_WEB:=https://github.com/christucker-sketch/PitchListUK/tree}"
: "${MYCNOTIFY_MAX_DAY:=5}"        # HTTP attempts per London calendar day (retries included)
: "${MYCNOTIFY_MAX_ATTEMPTS:=3}"   # per decision, definitely-not-accepted failures only
CRED=${CREDENTIALS_DIRECTORY:-/etc/mycnotify}   # systemd LoadCredential: smtp2go-key, notify.conf
CURL=curl
API=https://api.smtp2go.com/v3/email/send
if [[ ${MYCNOTIFY_TEST:-0} == 1 ]]; then CURL=$MYCNOTIFY_TEST_CURL CRED=$MYCNOTIFY_TEST_CRED; fi

H=$MYCNOTIFY_HOME HUB=$MYCNOTIFY_HOME/hub.git L=$MYCNOTIFY_HOME/ledger DRY=$MYCNOTIFY_HOME/dryrun
STATUS=$MYCNOTIFY_HOME/status.json LOCK=$MYCNOTIFY_HOME/lock PAUSE=$MYCNOTIFY_HOME/PAUSE
B=$MYCNOTIFY_BRANCH REV=refs/heads/$MYCNOTIFY_BRANCH

log() { echo "mycnotify: $*" >&2; }
G() { git --git-dir="$HUB" "$@"; }
now() { if [[ ${MYCNOTIFY_TEST:-0} == 1 && -n ${MYCNOTIFY_TEST_NOW:-} ]]; then echo "$MYCNOTIFY_TEST_NOW"; else date -u +%s; fi; }
iso() { date -u -d "@$1" +%Y-%m-%dT%H:%M:%SZ; }
lday() { TZ=Europe/London date -d "@$1" +%F; }

# ---------------------------------------------------------------- config (root-owned, read via systemd credentials)
SENDER="" RECIPIENT="" MODE=dry-run PIN="" CONF_ERR=""
conf_get() { grep -m1 -E "^$1=" "$CRED/notify.conf" 2>/dev/null | cut -d= -f2- || true; }
load_conf() {
  [[ -r $CRED/notify.conf ]] || { CONF_ERR="no notify.conf credential"; return 0; }
  SENDER=$(conf_get SENDER); RECIPIENT=$(conf_get RECIPIENT); MODE=$(conf_get MODE); PIN=$(conf_get PIN)
  [[ $MODE == live ]] || MODE=dry-run
  [[ $PIN =~ ^MYC-[0-9]{8}-[0-9]{3}-[0-9]{4}-[0-9a-f]{12}$ ]] || CONF_ERR="Stage C live needs PIN=<one decision key> (see: mycnotify decisions)"
  [[ $SENDER =~ ^[A-Za-z0-9._+-]+@findpitches\.com$ ]] || CONF_ERR="SENDER must be an address @findpitches.com"
  [[ $RECIPIENT =~ ^[^[:space:],\;\<\>\"]+@[^[:space:],\;\<\>\"]+$ ]] || CONF_ERR="RECIPIENT must be exactly one address"
}

# ---------------------------------------------------------------- hub (anonymous, objects only, never a work tree)
fetch() {
  if [[ ! -d $HUB ]]; then
    timeout 300 git clone -q --bare --single-branch --branch "$B" --no-tags "$MYCNOTIFY_REMOTE" "$HUB" || return 1
  fi
  timeout 120 git --git-dir="$HUB" fetch -q --no-tags origin "+refs/heads/$B:refs/heads/$B"
}

die() { log "STOP: $*"; exit 1; }
FOLD_REV=$REV FOLD_TASKS=$MYCNOTIFY_TASKS FOLD_DECISIONS=/var/lib/myc-decisions FOLD_TEST=0
if [[ ${MYCNOTIFY_TEST:-0} == 1 ]]; then FOLD_DECISIONS=$MYCNOTIFY_TEST_DECISIONS FOLD_TEST=1; fi
# >>> myc-fold (shared task validator: this block is byte-identical in myc-gate and mycnotify; test-fold-parity.sh checks it)
# Caller provides: G (git for its own clone), die, FOLD_REV (commit/ref to read), FOLD_TASKS (tasks root),
# FOLD_DECISIONS (owner record dir). Reads tracked regular blobs at FOLD_REV only; never a work tree.
TASK_RE='^MYC-[0-9]{8}-[0-9]{3}$'; RUN_RE='^MYC-[0-9]{8}-[0-9]{3}-r[0-9]{10}-[0-9a-f]{8}$'
blob_of() { local m t o; read -r m t o _ < <(G ls-tree "$FOLD_REV" -- "$1") || return 1
            [[ $t == blob && ( $m == 100644 || $m == 100755 ) ]] && echo "$o"; }
clean_text() {  # stdin -> ok if UTF-8 and no control bytes other than tab/newline/CR
  local f r; f=$(mktemp); cat > "$f"
  iconv -f UTF-8 -t UTF-8 "$f" >/dev/null 2>&1 && ! LC_ALL=C grep -qaP '[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]' "$f"; r=$?; rm -f "$f"; return $r; }
# Duplicate object members are detected on the token stream BEFORE any JSON tool normalises the object: a member path
# that was already completed (scalar value seen, or its container closed) and is seen again is a duplicate. This covers
# identical keys with different value shapes (container then scalar, scalar then container) at any depth.
DUP_JQ='reduce inputs as $e ({done:{}, dup:false};
  ($e[0]) as $p | . as $s |
  if ($e|length) == 2 then
     (if ([range(1; ($p|length)+1) as $k | $s.done[($p[0:$k]|tojson)] // false] | any) then .dup = true else . end)
     | .done[($p|tojson)] = true
  else .done[($p[0:-1]|tojson)] = true end) | .dup'
strict_json() {  # path max_bytes -> prints compact JSON object; fails on anything else
  local p=$1 max=$2 o raw
  o=$(blob_of "$p") || return 1
  [[ $(G cat-file -s "$o") -le $max ]] || return 1
  G cat-file -p "$o" | clean_text || return 1
  raw=$(G cat-file -p "$o")
  jq -e 'type == "object"' >/dev/null 2>&1 <<<"$raw" || return 1
  [[ $(jq -n --stream "$DUP_JQ" <<<"$raw" 2>/dev/null) == false ]] || return 1
  jq -c . <<<"$raw"
}
added_in() { G log --format=%H --diff-filter=A "$FOLD_REV" -- "$1" | tail -1; }

# ---------------------------------------------------------------- descriptor + history -> state
# Owner decision records: written ONLY by `sudo myc-decide` (root) on fpd-prod, one per decision key, BEFORE the event
# is published. Root-owned, not group/world writable, in a root-owned directory nobody else can write. Repository
# writers (agents, or anyone pushing with Chris's GitHub access) cannot create them. FOLD_TEST relaxes only the
# uid==0 checks, for the offline tests.
FOLD_REASON="" FOLD_REC=""
owner_record_get() {  # key -> sets FOLD_REC (compact JSON) or FOLD_REASON; call directly, not in $( ), to keep both
  local k=$1 f=$FOLD_DECISIONS/$1.json st
  FOLD_REASON="" FOLD_REC=""
  [[ $k =~ ^MYC-[0-9]{8}-[0-9]{3}-[0-9]{4}-[0-9a-f]{12}$ ]] || { FOLD_REASON="bad key"; return 1; }
  [[ -d $FOLD_DECISIONS && ! -L $FOLD_DECISIONS ]] || { FOLD_REASON="no owner record directory"; return 1; }
  [[ -f $f && ! -L $f ]] || { FOLD_REASON="no owner record for $k"; return 1; }
  for st in "$(stat -c '%u %a' "$FOLD_DECISIONS")" "$(stat -c '%u %a' "$f")"; do
    [[ ${FOLD_TEST:-0} == 1 || ${st%% *} == 0 ]] || { FOLD_REASON="owner record not root-owned"; return 1; }
    (( (8#${st##* } & 8#022) == 0 )) || { FOLD_REASON="owner record writable by others"; return 1; }
  done
  [[ $(stat -c %s "$f") -le 2048 ]] && jq -e 'type == "object"' "$f" >/dev/null 2>&1 || { FOLD_REASON="owner record is not a small JSON object"; return 1; }
  FOLD_REC=$(jq -c . "$f")
}
owner_record_matches() {  # key event-json -> ok if the record exists, is trustworthy, and states exactly this decision
  owner_record_get "$1" || return 1
  jq -e --argjson r "$FOLD_REC" --arg k "$1" '$r.key == $k and $r.status == .status and $r.reason == .reason
      and $r.decided_via == .decided_via and $r.prev_event == .prev_event and $r.descriptor_blob == .descriptor_blob' >/dev/null <<<"$2" \
    || { FOLD_REASON="event differs from the owner record"; return 1; }
}
STATE=""; SEQ=0; RUN=""; LEASE=""; CLAIM_AT=""; AGENT=""; DESC_BLOB=""; LAST_BLOB=""; Q=""
quarantine() { Q=$1; STATE=QUARANTINE; }
load() {
  local t=$1 d=$FOLD_TASKS/$1 j n f e prev st want aseq=0
  STATE=""; SEQ=0; RUN=""; LEASE=""; CLAIM_AT=""; AGENT=""; DESC_BLOB=""; LAST_BLOB=""; Q=""
  [[ $t =~ $TASK_RE ]] || die "bad task id: $t"
  [[ -n $(G ls-tree "$FOLD_REV" -- "$d/task.json") ]] || { STATE=ABSENT; return; }
  j=$(strict_json "$d/task.json" 8192) || { quarantine "task.json is not a strict JSON object"; return; }
  jq -e --arg t "$t" --arg rl "$d/result.md" '
      keys == ["assigned_agent","instructions","result_location","status","task_id"]
      and .task_id == $t and (.assigned_agent == "claude" or .assigned_agent == "codex")
      and (.instructions|type == "string" and length > 0 and utf8bytelength <= 4096)
      and .status == "pending" and .result_location == $rl' >/dev/null <<<"$j" \
    || { quarantine "task.json breaks the five-field contract"; return; }
  AGENT=$(jq -r .assigned_agent <<<"$j"); DESC_BLOB=$(blob_of "$d/task.json")
  while IFS= read -r f; do
    case $f in "$d/task.json"|"$d/result.md") ;; "$d"/events/[0-9][0-9][0-9][0-9].json) ;; *) quarantine "unexpected file $f"; return ;; esac
  done < <(G ls-tree -r --name-only "$FOLD_REV" -- "$d/")
  n=0; prev=""; st=""
  while :; do
    f=$(printf '%s/events/%04d.json' "$d" $((n + 1)))
    [[ -n $(G ls-tree "$FOLD_REV" -- "$f") ]] || break
    n=$((n + 1))
    e=$(strict_json "$f" 4096) || { quarantine "event $n is not a strict JSON object"; return; }
    jq -e --argjson n $n '(keys - ["seq","status","at","actor","reason","run_id","lease_until","descriptor_blob","prev_event","output_sha256","usage","decided_via"]) == []
        and .seq == $n and (.status|type == "string") and (.actor|type == "string")
        and (.at|type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"))
        and ((.reason // "")|type == "string") and ((.usage // {})|type == "object")' >/dev/null <<<"$e" \
      || { quarantine "event $n has bad fields, types or seq"; return; }
    want=$(jq -r .status <<<"$e")
    case "$st>$want" in
      ">pending")
        jq -e '.actor == "chris"' >/dev/null <<<"$e" && [[ $(added_in "$f") == $(added_in "$d/task.json") ]] \
          || { quarantine "event 1 must be pending by chris, created with task.json"; return; } ;;
      "pending>in_progress")
        jq -e --arg a "hubsync-gate for $AGENT" --arg db "$DESC_BLOB" --arg pe "$prev" \
            '.actor == $a and .descriptor_blob == $db and .prev_event == $pe and (.run_id|type == "string")
             and (.lease_until|type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"))' >/dev/null <<<"$e" \
          && [[ $(jq -r .run_id <<<"$e") =~ $RUN_RE && $(jq -r .run_id <<<"$e") == "$t-"* ]] \
          || { quarantine "claim event $n is not a valid writer claim"; return; }
        RUN=$(jq -r .run_id <<<"$e"); LEASE=$(jq -r .lease_until <<<"$e"); CLAIM_AT=$(jq -r .at <<<"$e") ;;
      "in_progress>completed")
        jq -e --arg r "$RUN" --arg pe "$prev" '.actor == "hubsync-gate" and .run_id == $r and .prev_event == $pe and (.output_sha256|type == "string" and test("^[0-9a-f]{64}$"))' >/dev/null <<<"$e" \
          && [[ -n $(G ls-tree "$FOLD_REV" -- "$d/result.md") && $(added_in "$d/result.md") == $(added_in "$f") ]] \
          && [[ $(G cat-file -p "$FOLD_REV:$d/result.md" | sha256sum | cut -c1-64) == $(jq -r .output_sha256 <<<"$e") ]] \
          || { quarantine "completion event $n does not match its run or result.md"; return; } ;;
      "in_progress>failed")
        jq -e --arg r "$RUN" --arg pe "$prev" '.actor == "hubsync-gate" and .run_id == $r and .prev_event == $pe and (.reason|type == "string")' >/dev/null <<<"$e" \
          || { quarantine "failure event $n does not match its run"; return; } ;;
      "in_progress>awaiting_approval")
        jq -e --arg r "$RUN" --arg pe "$prev" '.actor == "hubsync-gate" and .run_id == $r and .prev_event == $pe
            and (.reason|type == "string" and length > 0 and utf8bytelength <= 400 and (test("[\\n\\r\\t]")|not))' >/dev/null <<<"$e" \
          || { quarantine "decision request event $n does not match its run or has a bad summary"; return; }
        aseq=$n ;;
      "awaiting_approval>approved"|"awaiting_approval>rejected")
        jq -e --arg db "$DESC_BLOB" --arg pe "$prev" '.actor == "chris" and .prev_event == $pe and .descriptor_blob == $db
            and (.decided_via|type == "string" and test("^fpd-prod:sudo:[a-z_][a-z0-9_-]{0,31}$"))
            and (.reason|type == "string" and length > 0 and utf8bytelength <= 200 and (test("[\\n\\r\\t]")|not))' >/dev/null <<<"$e" \
          || { quarantine "decision event $n is not a valid recorded decision by Chris"; return; }
        # the repository alone cannot prove who decided (agents can push): the event counts only if it matches the
        # owner record that `sudo myc-decide` wrote as root on fpd-prod before publishing it
        owner_record_matches "$t-$(printf %04d "$aseq")-${prev:0:12}" "$e" \
          || { quarantine "decision event $n is not confirmed by an owner record on fpd-prod ($FOLD_REASON)"; return; } ;;
      *) quarantine "transition '${st:-none}' -> '$want' is not allowed in Stage B"; return ;;
    esac
    st=$want; prev=$(blob_of "$f")
  done
  [[ $n -ge 1 ]] || { quarantine "no events"; return; }
  [[ -z $(G ls-tree "$FOLD_REV" -- "$d/result.md") || $st == completed ]] || { quarantine "result.md present but task not completed"; return; }
  [[ $(G ls-tree --name-only "$FOLD_REV" -- "$d/events/" | wc -l) -eq $n ]] || { quarantine "gap in event numbering"; return; }
  STATE=$st; SEQ=$n; LAST_BLOB=$prev
}
# <<< myc-fold

# The notifier's view of one task is exactly the writer's validation (the shared block above). Sets F_STATE F_WHY
# F_DESC F_EV F_SEQ F_AGENT F_REASON.
fold() {
  F_STATE=QUARANTINE F_WHY="" F_DESC="" F_EV="" F_SEQ=0 F_AGENT="" F_REASON=""
  [[ $1 =~ $TASK_RE ]] || { F_WHY="bad task id"; return 0; }
  load "$1"
  case $STATE in
    QUARANTINE) F_WHY=$Q; return 0 ;;
    ABSENT) F_WHY="no task.json"; return 0 ;;
  esac
  F_STATE=$STATE F_DESC=$DESC_BLOB F_EV=$LAST_BLOB F_SEQ=$SEQ F_AGENT=$AGENT F_REASON=$(G cat-file -p "$LAST_BLOB" | jq -r .reason)
}

# ---------------------------------------------------------------- ledger (local, write-ahead, fsync'd)
ledger_all() { local f; for f in "$L"/*.json; do [[ -e $f ]] && cat "$f"; done; return 0; }
rec_get() { [[ -f $L/$1.json ]] && jq -r ".$2 // empty" "$L/$1.json" || true; }
rec_put() {  # key json
  local t; t=$(mktemp "$L/.tmp.XXXXXX")
  printf '%s\n' "$2" > "$t"; sync "$t"; mv -f "$t" "$L/$1.json"; sync "$L"
}
rec_update() {  # key jq-filter [args...]
  local k=$1 f=$2; shift 2
  rec_put "$k" "$(jq -c "$@" "$f" "$L/$k.json")"
}

# ---------------------------------------------------------------- send
summary() { tr '\r\n\t' '   ' <<<"$1" | LC_ALL=C tr -d '\000-\037\177' | cut -c1-400; }
body_json() {  # key id seq agent reason
  local link="$MYCNOTIFY_WEB/$B/$MYCNOTIFY_TASKS/$2"
  jq -n --arg from "$SENDER" --arg to "$RECIPIENT" --arg id "$2" --arg seq "$3" --arg agent "$4" --arg sum "$(summary "$5")" \
    --arg link "$link" --arg key "$1" '{sender: $from, to: [$to], subject: ("[FindPitches Mycelium] Approval needed: " + $id),
    text_body: ("A Mycelium task is waiting for your decision.\n\nTask: " + $id + " (assigned to " + $agent + ")\n"
      + "Decision event: " + $seq + "\nSummary: " + $sum + "\n\nReview it here: " + $link + "\n\n"
      + "Replying to this email does NOT approve or reject anything. To decide, on fpd-prod run:\n\n"
      + "  sudo myc-decide " + $key + " approve      (or: reject)\n\n"
      + "Recording a decision does not start or resume any agent work.\n\nNotice key: " + $key + "\n")}'
}
send() {  # key id seq agent reason -> sets OUT (accepted|retry|permanent|permanent_hold|uncertain) DETAIL RETRY_AFTER
  local apikey body resp hdr err code rc
  OUT=uncertain DETAIL="" RETRY_AFTER=0
  read -r apikey < "$CRED/smtp2go-key" || true
  [[ ${apikey:-} =~ ^[A-Za-z0-9_-]{10,200}$ ]] || { OUT=permanent_hold DETAIL="smtp2go-key credential missing or malformed"; return 0; }
  body=$(mktemp "$H/.body.XXXXXX"); resp=$(mktemp "$H/.resp.XXXXXX"); hdr=$(mktemp "$H/.hdr.XXXXXX"); err=$(mktemp "$H/.err.XXXXXX")
  body_json "$@" > "$body"
  set +e   # the key goes to curl on stdin (config), never on the command line, and is never logged
  code=$(printf 'header = "X-Smtp2go-Api-Key: %s"\n' "$apikey" | "$CURL" -sS --max-time 25 -K - -H 'Content-Type: application/json' \
    --data-binary @"$body" -D "$hdr" -o "$resp" -w '%{http_code}' "$API" 2>"$err"); rc=$?
  set -e
  if [[ $rc == 0 && $code == 200 ]] && jq -e '(.data.succeeded // 0) == 1 and (.data.failed // 0) == 0' "$resp" >/dev/null 2>&1; then
    OUT=accepted DETAIL=$(jq -r '.data.email_id // ""' "$resp")
  elif [[ $rc == 0 && $code == 200 ]]; then OUT=permanent DETAIL="provider refused: $(jq -c '.data.failures // .data' "$resp" 2>/dev/null | cut -c1-200)"
  elif [[ $rc == 6 || $rc == 7 ]]; then OUT=retry DETAIL="no connection (curl $rc); request not sent"
  elif [[ $rc == 0 && $code == 429 ]]; then OUT=retry DETAIL="HTTP 429"
    RETRY_AFTER=$(grep -i -m1 '^retry-after:' "$hdr" | tr -dc '0-9' || true); RETRY_AFTER=${RETRY_AFTER:-0}
  elif [[ $rc == 0 && ($code == 400 || $code == 401 || $code == 403) ]]; then OUT=permanent_hold DETAIL="HTTP $code: key/sender/config refused"
  elif [[ $rc == 0 && $code == 4* ]]; then OUT=permanent DETAIL="HTTP $code"
  else OUT=uncertain DETAIL="curl $rc, HTTP ${code:-none}: outcome unknown, not resent"
  fi
  rm -f "$body" "$resp" "$hdr" "$err"
}

# ---------------------------------------------------------------- commands
init() { mkdir -p "$H" "$L" "$DRY"; }
candidates() {  # "key id seq agent" lines for decisions outstanding now; quarantined tasks appended to $QFILE
  local id
  while IFS= read -r id; do
    [[ -n $id ]] || continue
    fold "$id"
    if [[ $F_STATE == QUARANTINE ]]; then printf '%s\t%s\n' "$id" "$F_WHY" >> "$QFILE"; continue; fi
    [[ $F_STATE == awaiting_approval ]] || continue
    printf '%s %s %s %s %s %s\n' "$id-$(printf %04d "$F_SEQ")-${F_EV:0:12}" "$id" "$F_SEQ" "$F_AGENT" "$F_DESC" "$F_EV"
  done < <(G ls-tree "$REV" -- "$MYCNOTIFY_TASKS/" | awk -F'\t' '$1 ~ / tree / {print $2}' | sed "s|^$MYCNOTIFY_TASKS/||")
}
write_status() {  # result message
  jq -n --arg r "$1" --arg m "$2" --arg t "$(iso "$(now)")" --arg mode "$MODE" \
    --arg init "$([[ -f $L/.initialized ]] && echo yes || echo no)" --arg hold "$([[ -f $L/HOLD ]] && cat "$L/HOLD" || true)" \
    --arg head "$(G rev-parse -q --verify "$REV" 2>/dev/null || true)" --rawfile q "$QFILE" \
    --argjson c "$(ledger_all | jq -s 'group_by(.state) | map({key: .[0].state, value: length}) | from_entries')" \
    '{last_run: $t, result: $r, message: $m, mode: $mode, initialized: $init, hold: $hold, hub_commit: $head, ledger: $c,
      quarantined: ($q | split("\n") | map(select(length > 0)))}' > "$STATUS.tmp" && mv -f "$STATUS.tmp" "$STATUS"
}

poll() {
  init; exec 9>"$LOCK"; flock -n 9 || { log "previous run still active; skipping"; exit 0; }
  QFILE=$(mktemp "$H/.q.XXXXXX"); trap 'rm -f "$QFILE"' EXIT
  load_conf
  if [[ -e $PAUSE ]]; then write_status paused "paused by operator"; exit 0; fi
  fetch || { write_status error "hub fetch failed"; exit 1; }
  # an interrupted claim (crash/reboot between claim and outcome) is uncertain and never resent
  local k f
  for f in "$L"/*.json; do
    [[ -e $f ]] || continue; k=$(basename "$f" .json)
    [[ $(jq -r .state "$f") == claimed ]] || continue
    rec_update "$k" '.state = "uncertain" | .detail = "interrupted between claim and outcome; not resent" | .updated_at = $t' --arg t "$(iso "$(now)")"
    log "UNCERTAIN $k: interrupted claim found; not resent"
  done
  local list; list=$(candidates)
  if [[ $MODE != live ]]; then
    local key id seq agent desc ev
    while read -r key id seq agent desc ev; do
      [[ -n ${key:-} && ! -f $DRY/$key.json ]] || continue
      jq -nc --arg k "$key" --arg t "$(iso "$(now)")" '{key: $k, would_send_at: $t}' > "$DRY/$key.json"; log "DRY RUN: would notify $key"
    done <<<"$list"
    write_status ok "dry run${CONF_ERR:+ ($CONF_ERR)}"; exit 0
  fi
  [[ -z $CONF_ERR ]] || { write_status error "live mode refused: $CONF_ERR"; exit 1; }
  [[ -f $L/.initialized ]] || { write_status error "ledger not initialised (new or lost): run 'mycnotify baseline' first; nothing sent"; exit 1; }
  [[ ! -f $L/HOLD ]] || { write_status held "global hold: $(cat "$L/HOLD"); fix config, then 'mycnotify release'"; exit 0; }
  local t today alog attempts_today sent=0 deferred=0 unpinned=0 state att next ra key id seq agent desc ev
  t=$(now); today=$(lday "$t"); alog=$L/attempts-$today.log
  attempts_today=0; [[ ! -f $alog ]] || attempts_today=$(wc -l < "$alog")
  while read -r key id seq agent desc ev; do
    [[ -n ${key:-} ]] || continue
    [[ $key == "$PIN" ]] || { unpinned=$((unpinned + 1)); continue; }   # Stage C: only the pinned decision
    state=$(rec_get "$key" state); att=$(rec_get "$key" attempts); att=${att:-0}; next=$(rec_get "$key" next_at); next=${next:-0}
    case $state in
      accepted|permanent|uncertain|baseline) continue ;;
      retry) [[ $t -ge $next ]] || continue ;;
    esac
    if [[ $sent -ge 1 || $attempts_today -ge $MYCNOTIFY_MAX_DAY ]]; then deferred=$((deferred + 1)); continue; fi
    # count the attempt and CLAIM first (both durable), then send
    printf '%s %s\n' "$(iso "$t")" "$key" >> "$alog"; sync "$alog"
    rec_put "$key" "$(jq -nc --arg k "$key" --arg id "$id" --arg seq "$seq" --arg desc "$desc" --arg ev "$ev" --argjson a "$((att + 1))" \
      --arg t "$(iso "$t")" --arg d "$today" '{key: $k, task_id: $id, seq: ($seq|tonumber), descriptor_blob: $desc, event_blob: $ev,
       state: "claimed", attempts: $a, claim_day: $d, claimed_at: $t, updated_at: $t}')"
    sent=$((sent + 1)); attempts_today=$((attempts_today + 1))
    send "$key" "$id" "$seq" "$agent" "$(G cat-file blob "$ev" | jq -r .reason)"
    case $OUT in
      retry)
        if [[ $((att + 1)) -ge $MYCNOTIFY_MAX_ATTEMPTS ]]; then OUT=permanent DETAIL="$DETAIL; attempts exhausted"
        else
          ra=$(( att == 0 ? 30 : 120 )); [[ $RETRY_AFTER -le $ra ]] || ra=$(( RETRY_AFTER > 3600 ? 3600 : RETRY_AFTER ))
          rec_update "$key" '.state = "retry" | .next_at = ($n|tonumber) | .detail = $d | .updated_at = $t' \
            --arg n "$((t + ra))" --arg d "$DETAIL" --arg t "$(iso "$t")"
          log "RETRY $key in ${ra}s: $DETAIL"; continue
        fi ;;
      permanent_hold) printf '%s\n' "$DETAIL" > "$L/HOLD"; OUT=permanent ;;
    esac
    rec_update "$key" '.state = $s | .detail = $d | .updated_at = $t' --arg s "$OUT" --arg d "$DETAIL" --arg t "$(iso "$t")"
    log "$(tr a-z A-Z <<<"$OUT") $key"
  done <<<"$list"
  local pinmsg=""; grep -q "^$PIN " <<<"$list" || pinmsg="; pinned decision is not outstanding"
  write_status ok "sent $sent, deferred $deferred, not pinned $unpinned (cap $MYCNOTIFY_MAX_DAY attempts/day, 1/run)$pinmsg"
}

baseline() {
  init; exec 9>"$LOCK"; flock -w 60 9 || { log "busy"; exit 1; }
  QFILE=$(mktemp "$H/.q.XXXXXX"); trap 'rm -f "$QFILE"' EXIT
  fetch || { log "hub fetch failed"; exit 1; }
  local n=0 key id seq agent desc ev t; t=$(iso "$(now)")
  while read -r key id seq agent desc ev; do
    [[ -n ${key:-} && ! -f $L/$key.json ]] || continue
    rec_put "$key" "$(jq -nc --arg k "$key" --arg id "$id" --arg t "$t" '{key: $k, task_id: $id, state: "baseline", updated_at: $t,
       detail: "outstanding when baselined; not notified"}')"; n=$((n + 1))
  done <<<"$(candidates)"
  touch "$L/.initialized"; log "baseline: $n outstanding decision(s) recorded as not-to-notify; ledger initialised"
}

decisions() {
  init; exec 9>"$LOCK"; flock -w 60 9 || { log "busy"; exit 1; }
  QFILE=$(mktemp "$H/.q.XXXXXX"); trap 'rm -f "$QFILE"' EXIT
  fetch || { log "hub fetch failed"; exit 1; }
  local key id seq agent desc ev
  while read -r key id seq agent desc ev; do
    [[ -n ${key:-} ]] || continue
    echo "$key  ledger=$(rec_get "$key" state | grep . || echo none)"
  done <<<"$(candidates)"
  [[ ! -s $QFILE ]] || { echo "quarantined:"; sed 's/^/  /' "$QFILE"; }
}

case "${1:-}" in
  poll) poll ;;
  baseline) baseline ;;
  decisions) decisions ;;
  release) init; rm -f "$L/HOLD"; log "global hold cleared" ;;
  status) init; cat "$STATUS" 2>/dev/null || echo '{}' ;;
  *) echo "usage: mycnotify poll|baseline|release|decisions|status"; exit 2 ;;
esac
