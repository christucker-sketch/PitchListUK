#!/usr/bin/env bash
# myc-decide — record Chris's approve/reject on a Mycelium task that is awaiting approval (fpd-prod only).
#   sudo myc-decide <decision_key> approve|reject ["one-line note"]
# The key is the "Notice key" in the approval email, or the "decision key" line of `myc-gate state <task>`.
# It shows the task's current state, asks you to type the task id to confirm, then records the decision on the hub
# through the one writer (myc-gate, as hubsync). It does NOT start, resume or authorise any agent work.
# Trust: a decision recorded this way proves someone with sudo on fpd-prod (normally Chris, via his SSH key and
# password) ran this command in a terminal. It is not a cryptographic signature.
set -euo pipefail
: "${MYC_AS_HUBSYNC:=runuser -u hubsync -- env -i HOME=/var/lib/hubsync LANG=C.UTF-8 PATH=/usr/local/bin:/usr/bin:/bin}"
: "${MYC_GATE:=/usr/local/bin/myc-gate}"
stop() { echo "myc-decide: STOP: $*" >&2; exit 1; }
if [[ ${MYC_TEST:-0} != 1 ]]; then
  [[ $EUID -eq 0 ]] || stop "run it as: sudo myc-decide <key> approve|reject"
  [[ $(hostname) == fpd-prod ]] || stop "fpd-prod only"
fi
[[ -n ${SUDO_USER:-} && $SUDO_USER != root && $SUDO_USER =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || stop "run it through sudo from your own account"
[[ -t 0 ]] || stop "needs an interactive terminal; decisions are never scripted"
[[ $# -ge 2 && $# -le 3 ]] || { echo "usage: sudo myc-decide <decision_key> approve|reject [\"one-line note\"]" >&2; exit 2; }
key=$1 act=$2 note=${3:-}
[[ $key =~ ^(MYC-[0-9]{8}-[0-9]{3})-[0-9]{4}-[0-9a-f]{12}$ ]] || stop "bad decision key: $key"
t=${BASH_REMATCH[1]}
[[ $act == approve || $act == reject ]] || stop "action must be approve or reject"
$MYC_AS_HUBSYNC "$MYC_GATE" state "$t" || stop "could not read $t"
read -r -p "Type $t to $act it (anything else cancels): " ans
[[ $ans == "$t" ]] || stop "not confirmed; nothing recorded"
$MYC_AS_HUBSYNC MYC_DECIDED_VIA="fpd-prod:sudo:$SUDO_USER" "$MYC_GATE" decide "$key" "$act" "$note"
