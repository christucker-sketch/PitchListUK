#!/usr/bin/env bash
# myc-gate — Mycelium Phase 0.2 Stage B: the ONE Git writer for task events and results (v2, after Codex review R1-R7).
# Runs as user hubsync, using hubsync's own clone and lock (serialised with the 5-minute poll; the poll is unchanged).
#   myc-gate state <task_id>     validated state, or QUARANTINE: reason (no push)
#   myc-gate grant               Stage B grant status from GitHub history of the allowlisted tasks (no push)
#   myc-gate claim <task_id>     commit + push the claim event; prints run_id. Does NOT authorise a model call.
#   myc-gate admit <run_id>      FINAL dispatch boundary: fresh re-read of the remote; the claim must still be the
#                                live last event, the grant open; atomically marks the run admitted (once ever) and
#                                writes the job packet. Only an admitted run may call a model.
#   myc-gate complete <run_id>   validate output; commit result.md + completed, or a failed receipt with a fixed code
#   myc-gate expire <task_id>    after the lease: commit failed (outcome_uncertain). Manual only.
#   myc-gate decide <key>        publish Chris's decision on a task that is awaiting_approval, exactly as stated in
#                                the root-owned owner record that `sudo myc-decide` wrote on fpd-prod (no record, no
#                                decision). Records only; never claims, admits, resumes or authorises agent work.
# Decision requests (26 Oct): a run whose runner leaves out/decision.md (and no result.md) ends in awaiting_approval
# with that bounded summary, instead of completed. approved/rejected are resting states: an approved task is NOT
# claimable (claim needs pending); resuming work needs a separately approved change.
# Local memory references (v3, Stage One, 29 Oct; PROPOSAL until installed by upgrade-gate.sh): a task line
# `memref: sha256:<64 hex>` attaches ONE root-owned local memory snapshot, $MYC_MEMSNAP/<digest>.md, as a reference. The
# digest is pinned by the GitHub task descriptor (whose blob the allowlist pins); the bytes never enter Git. At claim and
# again at admit the file is copied privately and must be root-owned, not group/other-writable (nor its folders), <= 32 KB,
# clean UTF-8 and EXACTLY that digest. It counts towards the 2-reference limit. Nothing else changes: the push contract,
# the shared fold block and myc-agent are untouched.
# Fail closed everywhere; never forces; never retries a rejected push; never calls a model.
set -euo pipefail
umask 027
: "${MYC_HOME:=/var/lib/hubsync}"
: "${MYC_SPOOL:=/var/lib/mycspool}"
: "${MYC_BRANCH:=findpitches-v3/greenfield}"
: "${MYC_TASKS:=greenfield/mycelium/tasks}"
: "${MYC_LEASE_MIN:=30}"
: "${MYC_ALLOW:=/etc/myc-stageb/allowed}"   # root-owned: "<task_id> <agent> <descriptor_blob>" per line
: "${MYC_MAX_CALLS:=2}"                     # claims (= at most one model call each) across the whole Stage B grant
: "${MYC_WINDOW_S:=1800}"                   # whole Stage B test, from the FIRST claim recorded on GitHub
: "${MYC_PUBLISH_MARGIN_S:=30}"             # time kept back inside the window for recording the outcome
: "${MYC_MIN_CALL_S:=20}"                   # admission needs at least this much time left before the deadline
PUSH_T=120; FETCH_T=60; PUB_END=""          # network bounds; PUB_END (absolute) is set only when publishing a result
: "${MYC_NAME:=hubsync}"
: "${MYC_EMAIL:=hubsync@$(hostname).invalid}"
REPO=$MYC_HOME/repo; LOCK=$MYC_HOME/lock; B=$MYC_BRANCH
: "${MYC_DECISIONS:=/var/lib/myc-decisions}"   # owner decision records (root-only writes; see myc-decide)
: "${MYC_MEMSNAP:=/var/lib/mycelium-memory/snapshots}"   # root-owned local memory snapshots, named <sha256>.md
FOLD_REV=HEAD FOLD_TASKS=$MYC_TASKS FOLD_DECISIONS=$MYC_DECISIONS FOLD_TEST=${MYC_TEST:-0}
SECRET_RE='-----BEGIN [A-Z ]*PRIVATE KEY-----|ghp_[A-Za-z0-9]{20,}|gh[ousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|sk-ant-[A-Za-z0-9_-]{10,}|sk-[A-Za-z0-9_-]{32,}|xox[abprs]-[A-Za-z0-9-]{10,}|AKIA[0-9A-Z]{16}|api[_-]?key["'"'"' :=]+[A-Za-z0-9_-]{20,}'

die() { echo "myc-gate: STOP: $*" >&2; exit 1; }
log() { echo "myc-gate: $*" >&2; }
G() { git -C "$REPO" "$@"; }
now() { date -u +%Y-%m-%dT%H:%M:%SZ; }
epoch() { date -u -d "$1" +%s; }

lock() { exec 9>"$LOCK"; flock -w 120 9 || die "hub watcher busy for 2 minutes; try again"; }
sync() {
  [[ -d $REPO/.git ]] || die "no clone at $REPO (hubsync not installed?)"
  timeout 120 git -C "$REPO" fetch -q --no-tags origin "+refs/heads/$B:refs/remotes/origin/$B" || die "fetch failed"
  G checkout -q -B hubsync-work "origin/$B"; G reset -q --hard "origin/$B"; G clean -qfdx
}

# >>> myc-fold (shared task validator: this block is byte-identical in myc-gate and mycnotify; test-fold-parity.sh checks it)
# Caller provides: G (git for its own clone), die, FOLD_REV (commit/ref to read), FOLD_TASKS (tasks root),
# FOLD_DECISIONS (owner record dir). Reads tracked regular blobs at FOLD_REV only; never a work tree.
TASK_RE='^MYC-[0-9]{8}-[0-9]{3}$'; RUN_RE='^MYC-[0-9]{8}-[0-9]{3}-r[0-9]{10}-[0-9a-f]{8}$'
blob_of() { local m t o; read -r m t o _ < <(G ls-tree "$FOLD_REV" -- "$1") || return 1
            [[ $t == blob && ( $m == 100644 || $m == 100755 ) ]] && echo "$o"; }
clean_text() {  # stdin -> ok if UTF-8 and no control bytes other than tab/newline/CR
  local f r; f=$(mktemp); cat > "$f"
  iconv -f UTF-8 -t UTF-8 "$f" >/dev/null 2>&1 && ! LC_ALL=C grep -qaP '[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]' "$f"; r=$?; rm -f "$f"; return $r; }
# Duplicate object members are detected on the token stream BEFORE any JSON tool normalises the object: a member path
# that was already completed (scalar value seen, or its container closed) and is seen again is a duplicate. This covers
# identical keys with different value shapes (container then scalar, scalar then container) at any depth.
DUP_JQ='reduce inputs as $e ({done:{}, dup:false};
  ($e[0]) as $p | . as $s |
  if ($e|length) == 2 then
     (if ([range(1; ($p|length)+1) as $k | $s.done[($p[0:$k]|tojson)] // false] | any) then .dup = true else . end)
     | .done[($p|tojson)] = true
  else .done[($p[0:-1]|tojson)] = true end) | .dup'
strict_json() {  # path max_bytes -> prints compact JSON object; fails on anything else
  local p=$1 max=$2 o raw
  o=$(blob_of "$p") || return 1
  [[ $(G cat-file -s "$o") -le $max ]] || return 1
  G cat-file -p "$o" | clean_text || return 1
  raw=$(G cat-file -p "$o")
  jq -e 'type == "object"' >/dev/null 2>&1 <<<"$raw" || return 1
  [[ $(jq -n --stream "$DUP_JQ" <<<"$raw" 2>/dev/null) == false ]] || return 1
  jq -c . <<<"$raw"
}
added_in() { G log --format=%H --diff-filter=A "$FOLD_REV" -- "$1" | tail -1; }

# ---------------------------------------------------------------- descriptor + history -> state
# Owner decision records: written ONLY by `sudo myc-decide` (root) on fpd-prod, one per decision key, BEFORE the event
# is published. Root-owned, not group/world writable, in a root-owned directory nobody else can write. Repository
# writers (agents, or anyone pushing with Chris's GitHub access) cannot create them. FOLD_TEST relaxes only the
# uid==0 checks, for the offline tests.
FOLD_REASON="" FOLD_REC=""
owner_record_get() {  # key -> sets FOLD_REC (compact JSON) or FOLD_REASON; call directly, not in $( ), to keep both
  local k=$1 f=$FOLD_DECISIONS/$1.json st
  FOLD_REASON="" FOLD_REC=""
  [[ $k =~ ^MYC-[0-9]{8}-[0-9]{3}-[0-9]{4}-[0-9a-f]{12}$ ]] || { FOLD_REASON="bad key"; return 1; }
  [[ -d $FOLD_DECISIONS && ! -L $FOLD_DECISIONS ]] || { FOLD_REASON="no owner record directory"; return 1; }
  [[ -f $f && ! -L $f ]] || { FOLD_REASON="no owner record for $k"; return 1; }
  for st in "$(stat -c '%u %a' "$FOLD_DECISIONS")" "$(stat -c '%u %a' "$f")"; do
    [[ ${FOLD_TEST:-0} == 1 || ${st%% *} == 0 ]] || { FOLD_REASON="owner record not root-owned"; return 1; }
    (( (8#${st##* } & 8#022) == 0 )) || { FOLD_REASON="owner record writable by others"; return 1; }
  done
  [[ $(stat -c %s "$f") -le 2048 ]] && jq -e 'type == "object"' "$f" >/dev/null 2>&1 || { FOLD_REASON="owner record is not a small JSON object"; return 1; }
  FOLD_REC=$(jq -c . "$f")
}
owner_record_matches() {  # key event-json -> ok if the record exists, is trustworthy, and states exactly this decision
  owner_record_get "$1" || return 1
  jq -e --argjson r "$FOLD_REC" --arg k "$1" '$r.key == $k and $r.status == .status and $r.reason == .reason
      and $r.decided_via == .decided_via and $r.prev_event == .prev_event and $r.descriptor_blob == .descriptor_blob' >/dev/null <<<"$2" \
    || { FOLD_REASON="event differs from the owner record"; return 1; }
}
STATE=""; SEQ=0; RUN=""; LEASE=""; CLAIM_AT=""; AGENT=""; DESC_BLOB=""; LAST_BLOB=""; Q=""
quarantine() { Q=$1; STATE=QUARANTINE; }
load() {
  local t=$1 d=$FOLD_TASKS/$1 j n f e prev st want aseq=0
  STATE=""; SEQ=0; RUN=""; LEASE=""; CLAIM_AT=""; AGENT=""; DESC_BLOB=""; LAST_BLOB=""; Q=""
  [[ $t =~ $TASK_RE ]] || die "bad task id: $t"
  [[ -n $(G ls-tree "$FOLD_REV" -- "$d/task.json") ]] || { STATE=ABSENT; return; }
  j=$(strict_json "$d/task.json" 8192) || { quarantine "task.json is not a strict JSON object"; return; }
  jq -e --arg t "$t" --arg rl "$d/result.md" '
      keys == ["assigned_agent","instructions","result_location","status","task_id"]
      and .task_id == $t and (.assigned_agent == "claude" or .assigned_agent == "codex")
      and (.instructions|type == "string" and length > 0 and utf8bytelength <= 4096)
      and .status == "pending" and .result_location == $rl' >/dev/null <<<"$j" \
    || { quarantine "task.json breaks the five-field contract"; return; }
  AGENT=$(jq -r .assigned_agent <<<"$j"); DESC_BLOB=$(blob_of "$d/task.json")
  while IFS= read -r f; do
    case $f in "$d/task.json"|"$d/result.md") ;; "$d"/events/[0-9][0-9][0-9][0-9].json) ;; *) quarantine "unexpected file $f"; return ;; esac
  done < <(G ls-tree -r --name-only "$FOLD_REV" -- "$d/")
  n=0; prev=""; st=""
  while :; do
    f=$(printf '%s/events/%04d.json' "$d" $((n + 1)))
    [[ -n $(G ls-tree "$FOLD_REV" -- "$f") ]] || break
    n=$((n + 1))
    e=$(strict_json "$f" 4096) || { quarantine "event $n is not a strict JSON object"; return; }
    jq -e --argjson n $n '(keys - ["seq","status","at","actor","reason","run_id","lease_until","descriptor_blob","prev_event","output_sha256","usage","decided_via"]) == []
        and .seq == $n and (.status|type == "string") and (.actor|type == "string")
        and (.at|type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"))
        and ((.reason // "")|type == "string") and ((.usage // {})|type == "object")' >/dev/null <<<"$e" \
      || { quarantine "event $n has bad fields, types or seq"; return; }
    want=$(jq -r .status <<<"$e")
    case "$st>$want" in
      ">pending")
        jq -e '.actor == "chris"' >/dev/null <<<"$e" && [[ $(added_in "$f") == $(added_in "$d/task.json") ]] \
          || { quarantine "event 1 must be pending by chris, created with task.json"; return; } ;;
      "pending>in_progress")
        jq -e --arg a "hubsync-gate for $AGENT" --arg db "$DESC_BLOB" --arg pe "$prev" \
            '.actor == $a and .descriptor_blob == $db and .prev_event == $pe and (.run_id|type == "string")
             and (.lease_until|type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"))' >/dev/null <<<"$e" \
          && [[ $(jq -r .run_id <<<"$e") =~ $RUN_RE && $(jq -r .run_id <<<"$e") == "$t-"* ]] \
          || { quarantine "claim event $n is not a valid writer claim"; return; }
        RUN=$(jq -r .run_id <<<"$e"); LEASE=$(jq -r .lease_until <<<"$e"); CLAIM_AT=$(jq -r .at <<<"$e") ;;
      "in_progress>completed")
        jq -e --arg r "$RUN" --arg pe "$prev" '.actor == "hubsync-gate" and .run_id == $r and .prev_event == $pe and (.output_sha256|type == "string" and test("^[0-9a-f]{64}$"))' >/dev/null <<<"$e" \
          && [[ -n $(G ls-tree "$FOLD_REV" -- "$d/result.md") && $(added_in "$d/result.md") == $(added_in "$f") ]] \
          && [[ $(G cat-file -p "$FOLD_REV:$d/result.md" | sha256sum | cut -c1-64) == $(jq -r .output_sha256 <<<"$e") ]] \
          || { quarantine "completion event $n does not match its run or result.md"; return; } ;;
      "in_progress>failed")
        jq -e --arg r "$RUN" --arg pe "$prev" '.actor == "hubsync-gate" and .run_id == $r and .prev_event == $pe and (.reason|type == "string")' >/dev/null <<<"$e" \
          || { quarantine "failure event $n does not match its run"; return; } ;;
      "in_progress>awaiting_approval")
        jq -e --arg r "$RUN" --arg pe "$prev" '.actor == "hubsync-gate" and .run_id == $r and .prev_event == $pe
            and (.reason|type == "string" and length > 0 and utf8bytelength <= 400 and (test("[\\n\\r\\t]")|not))' >/dev/null <<<"$e" \
          || { quarantine "decision request event $n does not match its run or has a bad summary"; return; }
        aseq=$n ;;
      "awaiting_approval>approved"|"awaiting_approval>rejected")
        jq -e --arg db "$DESC_BLOB" --arg pe "$prev" '.actor == "chris" and .prev_event == $pe and .descriptor_blob == $db
            and (.decided_via|type == "string" and test("^fpd-prod:sudo:[a-z_][a-z0-9_-]{0,31}$"))
            and (.reason|type == "string" and length > 0 and utf8bytelength <= 200 and (test("[\\n\\r\\t]")|not))' >/dev/null <<<"$e" \
          || { quarantine "decision event $n is not a valid recorded decision by Chris"; return; }
        # the repository alone cannot prove who decided (agents can push): the event counts only if it matches the
        # owner record that `sudo myc-decide` wrote as root on fpd-prod before publishing it
        owner_record_matches "$t-$(printf %04d "$aseq")-${prev:0:12}" "$e" \
          || { quarantine "decision event $n is not confirmed by an owner record on fpd-prod ($FOLD_REASON)"; return; } ;;
      *) quarantine "transition '${st:-none}' -> '$want' is not allowed in Stage B"; return ;;
    esac
    st=$want; prev=$(blob_of "$f")
  done
  [[ $n -ge 1 ]] || { quarantine "no events"; return; }
  [[ -z $(G ls-tree "$FOLD_REV" -- "$d/result.md") || $st == completed ]] || { quarantine "result.md present but task not completed"; return; }
  [[ $(G ls-tree --name-only "$FOLD_REV" -- "$d/events/" | wc -l) -eq $n ]] || { quarantine "gap in event numbering"; return; }
  STATE=$st; SEQ=$n; LAST_BLOB=$prev
}
# <<< myc-fold

# ---------------------------------------------------------------- Stage B grant, from GitHub history (not local state)
GRANT=""
grant_status() {  # [this_run] -> sets GRANT json; durable: derived only from the allowlisted tasks' events on GitHub
  local this=${1:-} id ag db claims=0 first="" held="" e
  [[ -r $MYC_ALLOW ]] || die "no Stage B allowlist at $MYC_ALLOW"
  while read -r id ag db; do
    [[ -n ${id:-} ]] || continue
    load "$id"
    case $STATE in
      ABSENT|pending) ;;
      completed|approved|rejected) claims=$((claims + 1)) ;;          # finished runs; a decision never re-opens a call
      in_progress) claims=$((claims + 1)); [[ $RUN == "$this" ]] || held+="$id:in_progress " ;;
      *) claims=$((claims + 1)); held+="$id:${STATE} " ;;
    esac
    if [[ -n $CLAIM_AT ]]; then e=$(epoch "$CLAIM_AT"); [[ -z $first || $e -lt $first ]] && first=$e; fi
  done < "$MYC_ALLOW"
  GRANT=$(jq -nc --argjson c $claims --arg f "${first:-}" --arg h "${held% }" --argjson now "$(date -u +%s)" \
    --argjson max "$MYC_MAX_CALLS" --argjson w "$MYC_WINDOW_S" \
    '{claims:$c, max:$max, first_claim_epoch:(if $f == "" then null else ($f|tonumber) end), window_s:$w, held:$h,
      window_left_s:(if $f == "" then $w else ($w - ($now - ($f|tonumber))) end)}')
}
grant_ok() {  # reason on failure
  local left; left=$(jq .window_left_s <<<"$GRANT")
  [[ -z $(jq -r .held <<<"$GRANT") ]] || { echo "an earlier Stage B task is failed, uncertain, quarantined or still running ($(jq -r .held <<<"$GRANT")); Chris decides"; return 1; }
  [[ $left -gt $MYC_PUBLISH_MARGIN_S ]] || { echo "the Stage B window has passed (30-minute limit from the first claim)"; return 1; }
}

commit_push() {  # message files... -> commits exactly these NEW files and pushes; never forces
  local msg=$1; shift
  G add -- "$@"
  local bad; bad=$(G diff --cached --name-status | awk -v ok="$(printf '%s\n' "$@")" 'BEGIN{n=split(ok,a,"\n");for(i=1;i<=n;i++)w[a[i]]=1} !($1=="A" && w[$2]){print}')
  [[ -z $bad ]] || die "refusing to commit anything but new task files: $bad"
  ! G diff --cached | LC_ALL=C grep -qaE -- "$SECRET_RE" || die "refusing to commit: content matches a credential pattern"
  G -c user.name="$MYC_NAME" -c user.email="$MYC_EMAIL" commit -q -m "$msg"
  [[ -z $(G diff --name-only "origin/$B" HEAD | grep -v "^$MYC_TASKS/MYC-[0-9]\{8\}-[0-9]\{3\}/\(events/[0-9]\{4\}\.json\|result\.md\)$" || true) ]] \
    || die "refusing to push files outside the task contract"
  local c rc=0 rem; c=$(G rev-parse HEAD)
  # Each network phase gets only the time left before the immutable publication end (if one applies), re-read right
  # before that phase; its hard kill lands inside that allowance (TERM at t-2, KILL at t).
  if [[ -n $PUB_END ]]; then
    rem=$(( PUB_END - $(date -u +%s) ))
    (( rem >= 5 )) || die "no time left before the Stage B grant end; NOTHING was pushed (confirmed); held for Chris"
    PUSH_T=$(( rem < 120 ? rem : 120 ))
  fi
  timeout -k 2 "$(( PUSH_T - 2 ))" git -C "$REPO" push -q origin "HEAD:refs/heads/$B" 2>"$MYC_HOME/gate-push.err" || rc=$?
  [[ $rc -ne 124 && $rc -ne 137 ]] || die "push of $c timed out: publication outcome UNCERTAIN (it may or may not have landed); held, nothing retried. Re-run later to reconcile"
  [[ $rc -eq 0 ]] || die "push rejected or failed ($(head -c 200 "$MYC_HOME/gate-push.err" | tr -cd '[:print:]')); nothing retried, nothing forced"
  if [[ -n $PUB_END ]]; then
    rem=$(( PUB_END - $(date -u +%s) ))
    (( rem >= 3 )) || die "pushed $c but no time left to confirm it before the grant end: result PUBLISHED but UNCONFIRMED; held for Chris"
    FETCH_T=$(( rem < 60 ? rem : 60 ))
  fi
  timeout -k 2 "$(( FETCH_T - 2 > 0 ? FETCH_T - 2 : 1 ))" git -C "$REPO" fetch -q --no-tags origin "+refs/heads/$B:refs/remotes/origin/$B" \
    || die "pushed $c but could not confirm it in time: result PUBLISHED but UNCONFIRMED (outcome uncertain); held"
  G merge-base --is-ancestor "$c" "origin/$B" || die "pushed $c is not on the remote branch (history rewound?)"
  if [[ -n $PUB_END && $(date -u +%s) -gt $PUB_END ]]; then
    die "$c is published and confirmed, but only AFTER the Stage B grant end (late); held for Chris"
  fi
  echo "$c"
}
event_json() { jq -n --arg at "$(now)" "$@"; }

memref_copy() {  # <sha256 hex> -> path of a private copy whose bytes are exactly that digest; fails closed otherwise
  local h=$1 f=$MYC_MEMSNAP/$1.md me=0 x tmp
  [[ $h =~ ^[0-9a-f]{64}$ ]] || return 1
  [[ ${MYC_TEST:-0} == 1 ]] && me=$(id -u)
  for x in "$(dirname "$MYC_MEMSNAP")" "$MYC_MEMSNAP" "$f"; do   # no symlink, root-owned, nobody else can write or swap it
    [[ -e $x && ! -L $x && $(stat -c %u "$x") == "$me" && $(( 0$(stat -c %a "$x") & 022 )) == 0 ]] || return 1
  done
  [[ -f $f && $(stat -c %s "$f") -le 32768 ]] || return 1
  tmp=$(mktemp "$MYC_HOME/.memref.XXXXXX"); head -c 32769 -- "$f" > "$tmp" 2>/dev/null || { rm -f "$tmp"; return 1; }
  if [[ $(stat -c %s "$tmp") -le 32768 && $(sha256sum "$tmp" | cut -d' ' -f1) == "$h" ]] && clean_text < "$tmp"; then echo "$tmp"
  else rm -f "$tmp"; return 1; fi
}

cmd_state() {
  lock; sync; load "$1"; echo "$1 ${STATE}${Q:+: $Q} seq=$SEQ${RUN:+ run=$RUN}${LEASE:+ lease_until=$LEASE}"
  if [[ $STATE == awaiting_approval ]]; then
    echo "  decision key: $1-$(printf %04d "$SEQ")-${LAST_BLOB:0:12}"
    echo "  summary: $(G cat-file -p "$LAST_BLOB" | jq -r .reason)"
    echo "  awaiting event: $LAST_BLOB"
    echo "  descriptor: $DESC_BLOB"
  fi
}
cmd_grant() { lock; sync; grant_status; echo "$GRANT"; grant_ok >&2 || exit 1; }

cmd_claim() {
  local t=$1 d=$MYC_TASKS/$1 run lease refs='[]' line p o c ev why
  lock; sync
  load "$t"
  [[ $STATE == pending ]] || die "$t is ${STATE}${Q:+ ($Q)}; only a pending task can be claimed (no replay)"
  [[ -r $MYC_ALLOW ]] || die "no Stage B allowlist at $MYC_ALLOW"
  grep -qxF "$t $AGENT $DESC_BLOB" "$MYC_ALLOW" || die "$t ($AGENT, descriptor ${DESC_BLOB:0:12}) is not in the Stage B allowlist"
  grant_status; why=$(grant_ok) || die "$why"
  [[ $(jq .claims <<<"$GRANT") -lt $MYC_MAX_CALLS ]] || die "Stage B call cap reached ($(jq .claims <<<"$GRANT") claims of $MYC_MAX_CALLS)"
  load "$t"
  while IFS= read -r line; do
    if [[ $line =~ ^memref:\ sha256:([0-9a-f]{64})$ ]]; then
      o=${BASH_REMATCH[1]}
      [[ $(jq length <<<"$refs") -lt 2 ]] || die "more than 2 refs"
      p=$(memref_copy "$o") || die "memory snapshot sha256:${o:0:12} is missing, not root-owned and sealed, too large, not clean text or not that digest"
      rm -f "$p"
      refs=$(jq -c --arg o "sha256:$o" '. + [{path:"mycelium-memory-snapshot (local; not in git; digest pinned by the task)", blob:$o}]' <<<"$refs")
      continue
    fi
    [[ $line =~ ^ref:\ (greenfield/mycelium/[A-Za-z0-9._/-]+)$ ]] || continue
    p=${BASH_REMATCH[1]}; [[ $p != *..* ]] || die "bad ref $p"
    [[ $(jq length <<<"$refs") -lt 2 ]] || die "more than 2 refs"
    if [[ $p =~ ^$MYC_TASKS/(MYC-[0-9]{8}-[0-9]{3})/result\.md$ ]]; then
      load "${BASH_REMATCH[1]}"; [[ $STATE == completed ]] || die "ref $p: that task is ${STATE}${Q:+ ($Q)}, not completed"; load "$t"
    fi
    o=$(blob_of "$p") || die "ref $p is not a tracked regular file"
    [[ $(G cat-file -s "$o") -le 32768 ]] || die "ref $p is larger than 32 KB"
    G cat-file -p "$o" | clean_text || die "ref $p is not plain UTF-8 text"
    refs=$(jq -c --arg p "$p" --arg o "$o" '. + [{path:$p, blob:$o}]' <<<"$refs")
  done < <(G cat-file -p "HEAD:$d/task.json" | jq -r .instructions)
  run="$t-r$(date -u +%s)-$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')"; [[ $run =~ $RUN_RE ]] || die "run id"
  lease=$(date -u -d "+$MYC_LEASE_MIN min" +%Y-%m-%dT%H:%M:%SZ)
  ev=$(printf '%s/events/%04d.json' "$d" $((SEQ + 1)))
  event_json --argjson s $((SEQ + 1)) --arg a "hubsync-gate for $AGENT" --arg r "$run" --arg l "$lease" --arg db "$DESC_BLOB" --arg pe "$LAST_BLOB" \
    '{seq:$s, status:"in_progress", at:$at, actor:$a, reason:"stage_b_manual_claim", run_id:$r, lease_until:$l, descriptor_blob:$db, prev_event:$pe}' > "$REPO/$ev"
  c=$(commit_push "mycelium: claim $t for $AGENT ($run)" "$ev")
  install -d -m 2750 "$MYC_SPOOL/$run"; install -d -m 2770 "$MYC_SPOOL/$run/out"
  jq -n --arg run "$run" --arg t "$t" --arg a "$AGENT" --arg c "$c" --arg db "$DESC_BLOB" --argjson refs "$refs" \
    '{run_id:$run, task_id:$t, agent:$a, claim_commit:$c, descriptor_blob:$db, refs:$refs}' > "$MYC_SPOOL/$run/claim.json"
  log "claimed $t for $AGENT in $c (not yet admitted: no model call allowed until 'admit')"
  echo "$run"
}

cmd_admit() {  # the last gate before inference: everything is re-read from the remote now
  local run=$1 cj t ag refs r p o deadline lease_e
  [[ $run =~ $RUN_RE ]] || die "bad run id"
  cj=$MYC_SPOOL/$run/claim.json; [[ -f $cj && ! -L $cj ]] || die "no claim record for $run"
  t=$(jq -r .task_id "$cj"); ag=$(jq -r .agent "$cj"); [[ $t =~ $TASK_RE && $run == "$t-"* ]] || die "claim record mismatch"
  lock; sync
  load "$t"
  [[ $STATE == in_progress && $RUN == "$run" && $AGENT == "$ag" ]] \
    || die "$t is now ${STATE}${Q:+ ($Q)}${RUN:+ (run $RUN)}; $run is not the live claim. NOT admitted, no model call"
  lease_e=$(epoch "$LEASE"); [[ $(date -u +%s) -lt $lease_e ]] || die "lease expired; not admitted"
  grep -qxF "$t $AGENT $DESC_BLOB" "$MYC_ALLOW" || die "descriptor no longer matches the allowlist; not admitted"
  grant_status "$run"; local why; why=$(grant_ok) || die "$why; not admitted"
  [[ $(jq .claims <<<"$GRANT") -le $MYC_MAX_CALLS ]] || die "Stage B call cap exceeded; not admitted"
  # pinned references must be unchanged and (for task results) still completed
  refs='[]'
  while read -r r; do
    p=$(jq -r .path <<<"$r"); o=$(jq -r .blob <<<"$r")
    if [[ $o =~ ^sha256:([0-9a-f]{64})$ ]]; then
      local mc; mc=$(memref_copy "${BASH_REMATCH[1]}") || die "memory snapshot ${o:0:19} is no longer present and intact; not admitted"
      refs=$(jq -c --arg p "$p" --arg o "$o" --rawfile c "$mc" '. + [{path:$p, blob:$o, content:$c}]' <<<"$refs"); rm -f "$mc"
      continue
    fi
    [[ $(blob_of "$p" || true) == "$o" ]] || die "reference $p changed since the claim; not admitted"
    if [[ $p =~ ^$MYC_TASKS/(MYC-[0-9]{8}-[0-9]{3})/result\.md$ ]]; then
      load "${BASH_REMATCH[1]}"; [[ $STATE == completed ]] || die "referenced task is no longer completed; not admitted"; load "$t"
    fi
    refs=$(jq -c --arg p "$p" --arg o "$o" --arg c "$(G cat-file -p "$o")" '. + [{path:$p, blob:$o, content:$c}]' <<<"$refs")
  done < <(jq -c '.refs[]' "$cj")
  # absolute deadline from durable facts only: first claim on GitHub + window, minus the publishing margin, capped by
  # the lease. Time spent on the checks above can never extend it; the clock is re-read right before admission.
  local first; first=$(jq -r .first_claim_epoch <<<"$GRANT"); [[ $first =~ ^[0-9]+$ ]] || die "no first claim time; not admitted"
  deadline=$(( first + MYC_WINDOW_S - MYC_PUBLISH_MARGIN_S )); [[ $deadline -lt $lease_e ]] || deadline=$lease_e
  [[ $(( $(date -u +%s) + MYC_MIN_CALL_S )) -lt $deadline ]] || die "the Stage B window has passed or too little time is left (deadline $(date -u -d "@$deadline" +%H:%M:%SZ)); not admitted"
  # admission happens at most once per run, atomically; a second admit (or a restart) can never re-open it
  mkdir "$MYC_SPOOL/$run/admitted" 2>/dev/null || die "$run was already admitted once; no replay"
  jq -n --arg run "$run" --arg t "$t" --arg a "$ag" --argjson dl "$deadline" --argjson refs "$refs" \
    --arg ins "$(G cat-file -p "HEAD:$MYC_TASKS/$t/task.json" | jq -r .instructions)" \
    '{run_id:$run, task_id:$t, agent:$a, deadline_epoch:$dl, instructions:$ins, refs:$refs}' > "$MYC_SPOOL/$run/job.tmp"
  chmod 0640 "$MYC_SPOOL/$run/job.tmp"; mv "$MYC_SPOOL/$run/job.tmp" "$MYC_SPOOL/$run/job.json"
  log "admitted $run for one $ag call; deadline $(date -u -d "@$deadline" +%H:%M:%SZ)"
  echo "$deadline"
}

read_out() {  # spool file max -> private copy (regular file only, no symlink, size cap); prints its path
  local src=$1 max=$2 tmp
  [[ -f $src && ! -L $src ]] || return 1
  tmp=$(mktemp "$MYC_HOME/.gate.XXXXXX")
  timeout 10 dd if="$src" of="$tmp" iflag=nofollow,nonblock bs=65536 count=$(( max / 65536 + 2 )) status=none 2>/dev/null || { rm -f "$tmp"; return 1; }
  [[ $(stat -c %s "$tmp") -le $max ]] || { rm -f "$tmp"; return 1; }
  echo "$tmp"
}

cmd_complete() {
  local run=$1 cj t ag ok code res meta usage d n ev c sha dl
  [[ $run =~ $RUN_RE ]] || die "bad run id"
  cj=$MYC_SPOOL/$run/claim.json; [[ -f $cj && ! -L $cj ]] || die "no claim record for $run"
  t=$(jq -r .task_id "$cj"); ag=$(jq -r .agent "$cj"); [[ $t =~ $TASK_RE && $run == "$t-"* ]] || die "claim record mismatch"
  lock; sync; load "$t"; d=$MYC_TASKS/$t
  if [[ $STATE == completed || $STATE == failed || $STATE == awaiting_approval || $STATE == approved || $STATE == rejected ]] && [[ $RUN == "$run" ]]; then
    log "$t already recorded as $STATE for $run (nothing to do)"; exit 0; fi
  [[ $STATE == in_progress && $RUN == "$run" ]] || die "$t is ${STATE}${Q:+ ($Q)} with run '${RUN}', not in_progress for $run; late result discarded"
  ok=false; code=""; usage=null
  # public receipts carry fixed codes only; the runner's free-text error stays in its private log
  if meta=$(read_out "$MYC_SPOOL/$run/out/meta.json" 4096) && jq -e 'type == "object"' "$meta" >/dev/null 2>&1 \
     && [[ $(jq -n --stream "$DUP_JQ" < "$meta" 2>/dev/null) == false ]]; then
    usage=$(jq -c --arg ag "$ag" 'def num(f): ([f|numbers|select(. >= 0 and . < 1e9)] | first) // null;
        def tok(f; re): ([f|strings|select(test(re))] | first) // null;
        {agent: $ag, model: tok(.model; "^[A-Za-z0-9.,:_ -]{1,48}$"), cli_version: tok(.cli_version; "^[A-Za-z0-9 ().,_-]{1,48}$"),
         seconds: num(.seconds), input_tokens: num(.usage.input_tokens?), cached_input_tokens: num(.usage.cached_input_tokens?),
         output_tokens: num(.usage.output_tokens?), api_equivalent_usd_not_billed: num(.api_equivalent_usd)}' "$meta" 2>/dev/null) || usage=null
    [[ -n $usage ]] || usage=null
    # free-text fields that look like a credential are dropped, never published
    if LC_ALL=C grep -qaE -- "$SECRET_RE" <<<"$usage"; then usage=$(jq -c '.model = null | .cli_version = null' <<<"$usage"); fi
    if [[ $(jq -r .ok "$meta") == true && $(jq -r '.agent // ""' "$meta") == "$ag" ]]; then ok=true
    elif [[ $(jq -r '.called' "$meta") == false ]]; then code=failed_before_call   # the runner stopped before any model call
    else code=runner_failed; fi
    rm -f "$meta"
  elif [[ -e $MYC_SPOOL/$run/out/started ]]; then code=outcome_uncertain
  elif [[ -e $MYC_SPOOL/$run/admitted ]]; then code=outcome_uncertain
  else code=not_admitted_no_call
  fi
  [[ -f $MYC_SPOOL/$run/job.json ]] && dl=$(jq -r .deadline_epoch "$MYC_SPOOL/$run/job.json") || dl=$(epoch "$LEASE")
  local pub_end=$(( dl + MYC_PUBLISH_MARGIN_S )) left_s   # = the absolute grant end (or lease + margin), never later
  left_s=$(( pub_end - $(date -u +%s) ))
  if [[ $(date -u +%s) -gt $(epoch "$LEASE") ]]; then ok=false; code=lease_expired
  elif [[ $left_s -lt 10 ]]; then ok=false; code=deadline_passed; fi
  local dec="" summary=""
  if $ok && [[ -e $MYC_SPOOL/$run/out/decision.md || -L $MYC_SPOOL/$run/out/decision.md ]]; then
    # the runner asks for Chris's decision instead of delivering a result: exactly one of the two, bounded, clean
    if [[ -e $MYC_SPOOL/$run/out/result.md || -L $MYC_SPOOL/$run/out/result.md ]]; then ok=false; code=ambiguous_output
    elif dec=$(read_out "$MYC_SPOOL/$run/out/decision.md" 1024) && [[ -s $dec ]] && clean_text < "$dec" && ! LC_ALL=C grep -qaE -- "$SECRET_RE" "$dec"; then
      summary=$(tr '\r\n\t' '   ' < "$dec" | sed -e 's/  */ /g' -e 's/^ //' -e 's/ $//'); rm -f "$dec"
      [[ -n $summary && $(printf %s "$summary" | wc -c) -le 400 ]] || { ok=false; code=decision_rejected; summary=""; }
    else
      [[ -n $dec ]] && rm -f "$dec"; ok=false; code=decision_rejected
    fi
  fi
  if $ok && [[ -z $summary ]]; then
    if res=$(read_out "$MYC_SPOOL/$run/out/result.md" 16384) && [[ -s $res ]] && clean_text < "$res" && ! LC_ALL=C grep -qaE -- "$SECRET_RE" "$res"; then
      cp "$res" "$REPO/$d/result.md"; sha=$(sha256sum "$res" | cut -c1-64); rm -f "$res"
    else
      [[ -n ${res:-} ]] && rm -f "$res"; ok=false; code=result_rejected
    fi
  fi
  n=$((SEQ + 1)); ev=$(printf '%s/events/%04d.json' "$d" $n)
  if $ok; then
    # a RESULT is published only inside the absolute grant end: commit_push re-reads the clock before the push and
    # again before the confirming fetch, and checks it once more before reporting success (no automatic retry).
    (( pub_end - $(date -u +%s) >= 10 )) && PUB_END=$pub_end || { ok=false; code=deadline_passed; rm -f "$REPO/$d/result.md"; }
  fi
  if $ok && [[ -n $summary ]]; then
    event_json --argjson s $n --arg r "$run" --arg pe "$LAST_BLOB" --arg why "$summary" --argjson u "$usage" \
      '{seq:$s, status:"awaiting_approval", at:$at, actor:"hubsync-gate", reason:$why, run_id:$r, prev_event:$pe, usage:$u}' > "$REPO/$ev"
    c=$(commit_push "mycelium: $t awaiting approval ($run)" "$ev")
    log "$t AWAITING APPROVAL in $c; decision key $t-$(printf %04d "$n")-$(G rev-parse "HEAD:$ev" | cut -c1-12)"
  elif $ok; then
    event_json --argjson s $n --arg r "$run" --arg pe "$LAST_BLOB" --arg h "$sha" --argjson u "$usage" \
      '{seq:$s, status:"completed", at:$at, actor:"hubsync-gate", reason:"result_accepted", run_id:$r, prev_event:$pe, output_sha256:$h, usage:$u}' > "$REPO/$ev"
    c=$(commit_push "mycelium: $t completed ($run)" "$ev" "$d/result.md"); log "$t COMPLETED in $c; result sha256 $sha"
  else
    event_json --argjson s $n --arg r "$run" --arg pe "$LAST_BLOB" --arg why "$code" --argjson u "$usage" \
      '{seq:$s, status:"failed", at:$at, actor:"hubsync-gate", reason:$why, run_id:$r, prev_event:$pe, usage:$u}' > "$REPO/$ev"
    c=$(commit_push "mycelium: $t failed: $code ($run)" "$ev"); log "$t FAILED ($code) in $c"
  fi
  echo "$c"
}

cmd_expire() {
  local t=$1 d=$MYC_TASKS/$1 ev c
  lock; sync; load "$t"
  [[ $STATE == in_progress ]] || die "$t is ${STATE}${Q:+ ($Q)}, not in_progress"
  [[ $(date -u +%s) -gt $(epoch "$LEASE") ]] || die "lease for $RUN runs until $LEASE; not expired"
  ev=$(printf '%s/events/%04d.json' "$d" $((SEQ + 1)))
  event_json --argjson s $((SEQ + 1)) --arg r "$RUN" --arg pe "$LAST_BLOB" \
    '{seq:$s, status:"failed", at:$at, actor:"hubsync-gate", reason:"outcome_uncertain", run_id:$r, prev_event:$pe}' > "$REPO/$ev"
  c=$(commit_push "mycelium: $t lease expired ($RUN)" "$ev"); log "$t marked failed (outcome_uncertain) in $c"; echo "$c"
}

cmd_decide() {  # key -> publishes exactly the decision in the root-owned owner record. Records, never executes.
  local key=$1 t seq b12 rec ev c st
  [[ $key =~ ^(MYC-[0-9]{8}-[0-9]{3})-([0-9]{4})-([0-9a-f]{12})$ ]] || die "bad decision key: $key"
  t=${BASH_REMATCH[1]}; seq=$((10#${BASH_REMATCH[2]})); b12=${BASH_REMATCH[3]}
  owner_record_get "$key" || die "no trustworthy owner record for $key ($FOLD_REASON): decisions are made only with 'sudo myc-decide' on fpd-prod"
  rec=$FOLD_REC
  jq -e '(.status == "approved" or .status == "rejected") and (.reason|type == "string" and length > 0 and utf8bytelength <= 200)
      and (.decided_via|type == "string" and test("^fpd-prod:sudo:[a-z_][a-z0-9_-]{0,31}$"))' >/dev/null <<<"$rec" || die "owner record for $key is malformed"
  ! LC_ALL=C grep -qaE -- "$SECRET_RE" <<<"$rec" || die "owner record looks like it contains a credential; nothing recorded"
  lock; sync; load "$t"
  [[ $STATE == awaiting_approval ]] || die "$t is ${STATE}${Q:+ ($Q)}; there is no outstanding decision to record"
  [[ $SEQ -eq $seq && ${LAST_BLOB:0:12} == "$b12" ]] \
    || die "$key is not the current decision for $t (current: $t-$(printf %04d "$SEQ")-${LAST_BLOB:0:12}); nothing recorded"
  jq -e --arg pe "$LAST_BLOB" --arg db "$DESC_BLOB" '.prev_event == $pe and .descriptor_blob == $db' >/dev/null <<<"$rec" \
    || die "owner record for $key is bound to a different event or descriptor; nothing recorded"
  st=$(jq -r .status <<<"$rec")
  ev=$(printf '%s/events/%04d.json' "$MYC_TASKS/$t" $((SEQ + 1)))
  event_json --argjson s $((SEQ + 1)) --argjson r "$rec" \
    '{seq:$s, status:$r.status, at:$at, actor:"chris", reason:$r.reason, prev_event:$r.prev_event, descriptor_blob:$r.descriptor_blob, decided_via:$r.decided_via}' > "$REPO/$ev"
  c=$(commit_push "mycelium: $t $st by Chris (decision $key)" "$ev")
  load "$t"; [[ $STATE == "$st" ]] || die "published $c but the validator reads $t as ${STATE}${Q:+ ($Q)}"
  log "$t $st in $c. This records the decision only; it does not start, resume or authorise any agent work."
  echo "$c"
}

case "${1:-}" in
  state)    cmd_state "${2:?task_id}" ;;
  grant)    cmd_grant ;;
  claim)    cmd_claim "${2:?task_id}" ;;
  admit)    cmd_admit "${2:?run_id}" ;;
  complete) cmd_complete "${2:?run_id}" ;;
  expire)   cmd_expire "${2:?task_id}" ;;
  decide)   cmd_decide "${2:?decision_key}" ;;
  *) echo "usage: myc-gate state|claim|expire <task_id> | admit|complete <run_id> | grant | decide <key>" >&2; exit 2 ;;
esac
