# Copy to .env (never commit .env). All optional.
# Where the live database and raw-page cache live (default: ./data)
# FPD_DATA_DIR=./data
# Optional mirror of the DB (used when the live DB is on a scratch disk)
# FPD_SNAPSHOT=./data/fpd.sqlite
# Contact string added to the crawler User-Agent (recommended: an email or URL)
# FPD_CONTACT=mailto:you@example.com
# FPD_CONCURRENCY=16
# FPD_HOST_DELAY=2.0
# FPD_SITE_BUDGET=8
# Optional search-API generator (Brave Search). Engine works without it.
# BRAVE_API_KEY=
# Where integration exports are published (default: ./integration_export)
# FPD_EXPORT_DIR=./integration_export
# Treat this ISO date as "today" (testing only)
# FPD_TODAY=2026-10-05
