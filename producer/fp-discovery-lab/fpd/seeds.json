   "note": "Marketspread market application pages"
  },
  {
   "name": "localstalls",
   "sitemaps": [
    "https://localstalls.com/sitemap.xml"
   ],
   "child_pattern": "events-(au|nz|uk|us)-",
   "pattern": "/(au|nz|uk|us)/event/[^/]+/[^/]+$",
   "max_age_days": 3650,
