#!/usr/bin/env bash
# FindPitches Pi health alerts by email (SMTP2GO HTTP API). Read-only checks; run every 15 min by fpd-alert.timer.
#   fpd-alert-check            check, then email new problems / reminders / resolutions (and the daily summary)
#   fpd-alert-check --test     send one test email now
#   fpd-alert-check --show     print current problems, send nothing
# Config: /etc/fpd/alert.env (root, 0600) with SMTP2GO_API_KEY, ALERT_FROM, ALERT_TO, optional ALERT_DAILY_HOUR (0-23, default 8)
#   and ALERT_QUIET (no emails in these local hours, default "22-7" = 22:00-07:00; "off" to disable).
#   Problems seen during quiet hours are reported in one email at the end of them, including ones that already cleared.
# The API key is passed to curl on stdin, never on the command line, and is never printed or logged.
set -uo pipefail
umask 077
CONF=${FPD_ALERT_CONF:-/etc/fpd/alert.env}
STATE_DIR=${FPD_ALERT_STATE:-/var/lib/fpd-alert}
SRV=${FPD_SRV:-/srv/fpd}
STATUS=$SRV/delivery/state/status.json
OFFSITE=$SRV/backups/offsite-status.json
NOW=${FPD_ALERT_NOW:-$(date +%s)}
HOST=$(hostname)
REPEAT_S=$((6*3600)); MAX_PER_HOUR=8
MODE=${1:-check}

[[ -r $CONF ]] || { echo "fpd-alert: $CONF missing (run: sudo fpd-alert-setup)" >&2; exit 0; }
set -a
# shellcheck source=/dev/null
. "$CONF"
set +a
: "${ALERT_DAILY_HOUR:=8}" "${ALERT_QUIET:=22-7}"
mkdir -p "$STATE_DIR"; STATE=$STATE_DIR/state.json
[[ -s $STATE ]] && jq -e . "$STATE" >/dev/null 2>&1 || echo '{"active":{},"sent":[],"daily":"","boot":""}' > "$STATE"

age_of() { local t; t=$(date -d "$1" +%s 2>/dev/null) || { echo -1; return; }; echo $(( NOW - t )); }
hrs() { awk -v s="$1" 'BEGIN{printf "%.1f", s/3600}'; }
clean() { grep -viE 'token|bearer|authoriz|api[-_]?key|password|secret' | cut -c1-300; }

# ------------------------------------------------------------------ checks: one line per problem, "key<TAB>message"
problems() {
  local r a s
  # discovery cycle
  r=$(systemctl show fpd-acquire -p ActiveState --value 2>/dev/null)
  if [[ $r == failed ]]; then
    local at; at=$(systemctl show fpd-acquire -p ExecMainExitTimestamp --value)
    local why; why=$(journalctl -u fpd-acquire --since "$(systemctl show fpd-acquire -p ExecMainStartTimestamp --value)" --no-pager -o cat 2>/dev/null \
      | grep -E 'FAILED|failed|export_failed|Traceback|Error' | clean | tail -4 | tr '\n' ' ')
    printf 'acquire_failed\tDiscovery cycle FAILED (ended %s). %s\n' "$at" "${why:-see: journalctl -u fpd-acquire}"
  fi
  # discovery timer and export freshness (22 Oct: a maintenance step left the timer stopped for ~24h; delivery kept
  # polling, so V3 saw a heartbeat with a stale export and nothing here noticed)
  [[ $(systemctl is-active fpd-acquire.timer 2>/dev/null) == active ]] || \
    printf 'timer_off\tDiscovery timer is OFF: no discovery cycles or exports will run. Fix: sudo systemctl enable --now fpd-acquire.timer\n'
  local cur=$SRV/export/full/current.jsonl
  if [[ -f $cur ]]; then
    # cycles start every 3 h (+ up to 15 min jitter) and export about an hour in: normal gaps reach ~3.6 h, so alert at
    # 4.5 h, i.e. once a cycle has clearly been missed (22 Oct: 3 h would have raised false alarms on normal cycles)
    a=$(( NOW - $(stat -c %Y "$cur") )); [[ $a -gt 16200 ]] && \
      printf 'export_stale\tNewest full export is %sh old (cycles run every 3 hours; at least one has been missed)\n' "$(hrs $a)"
  fi
  # delivery
  if [[ -r $STATUS ]]; then
    local st; st=$(jq -c '{checked_at,rejected:(.rejected//0),cf:(.consecutive_failures//0),error,age:(.source_age_seconds//null),status}' "$STATUS" 2>/dev/null)
    if [[ -n $st ]]; then
      a=$(age_of "$(jq -r .checked_at <<<"$st")")
      [[ $a -lt 0 || $a -gt 2700 ]] && printf 'delivery_stalled\tNo V3 delivery for %sh (last %s). Check: systemctl status fpd-v3-delivery\n' "$(hrs $a)" "$(jq -r .checked_at <<<"$st")"
      [[ $(jq .rejected <<<"$st") -gt 0 ]] && printf 'delivery_rejected\tV3 rejected %s records in the last delivery\n' "$(jq .rejected <<<"$st")"
      if [[ $(jq .cf <<<"$st") -ge 2 || $(jq -r '.error // empty' <<<"$st") != "" ]]; then
        printf 'delivery_failing\tV3 delivery failing: status=%s error=%s consecutive_failures=%s\n' "$(jq -r .status <<<"$st")" "$(jq -r '.error // "none"' <<<"$st" | clean)" "$(jq .cf <<<"$st")"
      fi
      s=$(jq -r '.age // empty' <<<"$st")
      [[ -n $s && $s -gt 25200 ]] && printf 'source_stale\tProducer source data is %sh old (newest page check); a discovery cycle has been missed twice\n' "$(hrs $s)"
    fi
    [[ $(systemctl is-active fpd-v3-delivery 2>/dev/null) == active ]] || printf 'delivery_down\tfpd-v3-delivery service is not running\n'
  fi
  # other fpd units in failed state (backup, prune, off-site)
  for u in $(systemctl list-units 'fpd-*' --state=failed --no-legend --plain 2>/dev/null | awk '{print $1}' | grep -v '^fpd-acquire.service$'); do
    printf 'unit_%s\t%s FAILED: %s\n' "${u%.service}" "$u" "$(journalctl -u "$u" -n 3 --no-pager -o cat 2>/dev/null | clean | tr '\n' ' ')"
  done
  # backups
  local newest; newest=$(ls -1t "$SRV"/backups/fpd-*.sqlite.zst 2>/dev/null | head -1)
  if [[ -z $newest ]]; then printf 'backup_missing\tNo local database backup found\n'
  else a=$(( NOW - $(stat -c %Y "$newest") )); [[ $a -gt 129600 ]] && printf 'backup_stale\tNewest local backup is %sh old\n' "$(hrs $a)"; fi
  if [[ -r $OFFSITE ]]; then
    [[ $(jq -r .ok "$OFFSITE") == true ]] || printf 'offsite_failed\tOff-site backup failed: %s\n' "$(jq -r '.error // "unknown"' "$OFFSITE" | clean)"
    a=$(age_of "$(jq -r .at "$OFFSITE")"); [[ $a -lt 0 || $a -gt 129600 ]] && printf 'offsite_stale\tLast off-site backup was %sh ago\n' "$(hrs $a)"
  fi
  # host
  if command -v vcgencmd >/dev/null; then
    local th; th=$(( $(vcgencmd get_throttled | cut -d= -f2) ))
    # Under-voltage comes and goes with load, so one problem stays open until 24 h pass without it (no email flapping).
    (( th & 0x5 )) && touch -d "@$NOW" "$STATE_DIR/power_seen"
    if [[ -f $STATE_DIR/power_seen ]]; then
      local ps; ps=$(stat -c %Y "$STATE_DIR/power_seen")
      (( NOW - ps < 86400 )) && printf 'power_unstable\tUNDER-VOLTAGE/throttling seen (last at %s, throttled=0x%x). The power supply needs replacing. Clears after 24h without it\n' "$(date -d "@$ps" '+%a %H:%M')" "$th"
    fi
    local t; t=$(vcgencmd measure_temp | grep -oE '[0-9]+' | head -1)
    [[ -n $t && $t -ge 75 ]] && printf 'temp_high\tCPU temperature %s C\n' "$t"
  fi
  local use; use=$(df --output=pcent "$SRV" 2>/dev/null | tail -1 | tr -dc 0-9)
  [[ -n $use && $use -ge 85 ]] && printf 'disk_full\tData disk %s%% full\n' "$use"
  local mem; mem=$(awk '/MemAvailable/{print int($2/1024)}' /proc/meminfo)
  [[ -n $mem && $mem -lt 60 ]] && printf 'memory_low\tOnly %s MB memory available\n' "$mem"
}

when() { date -d "$1" '+%a %d %b %H:%M' 2>/dev/null || echo "$1"; }   # any timestamp -> local "Fri 16 Oct 13:22"

summary() {
  echo "Host: $HOST · $(date -d "@$NOW" '+%a %d %b %Y %H:%M %Z') · up $(uptime -p 2>/dev/null | sed 's/^up //')"
  if [[ -r $STATUS ]]; then
    local d; d=$(jq -r '[.status, .checked_at, (.accepted|tostring), (.records|tostring), (.rejected|tostring),
                         (.pending_rechecks|tostring), ((((.source_age_seconds//0)/360)|floor)/10|tostring)] | join("\t")' "$STATUS" 2>/dev/null)
    if [[ -n $d ]]; then
      local st at acc rec rej pend age; IFS=$'\t' read -r st at acc rec rej pend age <<<"$d"
      echo "V3 delivery: $st $(when "$at") · $acc of $rec accepted, $rej rejected · rechecks pending $pend · source data ${age}h old"
    fi
  fi
  local last next res; last=$(systemctl show fpd-acquire -p ExecMainStartTimestamp --value 2>/dev/null)
  next=$(systemctl show fpd-acquire.timer -p NextElapseUSecRealtime --value 2>/dev/null); res=$(systemctl show fpd-acquire -p Result --value 2>/dev/null)
  echo "Discovery cycle: last $(when "$last") (${res:-unknown}) · next $(when "$next")"
  [[ -r $OFFSITE ]] && echo "Off-site backup: $(jq -r 'if .ok then "OK" else "FAILED" end' "$OFFSITE" 2>/dev/null) $(when "$(jq -r .at "$OFFSITE" 2>/dev/null)")"
  if command -v vcgencmd >/dev/null; then
    local th; th=$(vcgencmd get_throttled | cut -d= -f2)
    echo "Power: $([[ $th == 0x0 ]] && echo "OK (no under-voltage since boot)" || echo "under-voltage/throttling seen since boot (throttled=$th)") · CPU $(vcgencmd measure_temp | grep -oE '[0-9.]+' | head -1)°C"
  fi
  echo "Disk: $(df -h --output=used,size "$SRV" 2>/dev/null | tail -1 | awk '{print $1" used of "$2}')"
}

# Plain-text body -> simple HTML email (inline styles: mail clients drop <style>). The text stays as the fallback part.
render_html() {
  command -v python3 >/dev/null || return 1
  ALERT_SUBJ="$1" ALERT_BODY="$2" python3 -I - <<'PY'
import html, os, re
subj, body = os.environ["ALERT_SUBJ"], os.environ["ALERT_BODY"]
e = html.escape
# Outlook for Windows renders HTML with Word: padding/margins on <div>, max-width and rounded corners are ignored.
# So the layout is tables with padding on <td> and colours given as bgcolor attributes as well as styles.
FONT = "font-family:Segoe UI,Helvetica,Arial,sans-serif;"
KIND = [("PROBLEM", "#c62828", "Problem"), ("STILL WRONG", "#ef6c00", "Still wrong"), ("RESOLVED", "#2e7d32", "Resolved"),
        ("OVERNIGHT", "#546e7a", "Overnight"), ("daily: all OK", "#2e7d32", "Daily summary"), ("daily", "#ef6c00", "Daily summary"),
        ("Pi restarted", "#ef6c00", "Pi restarted"), ("test", "#1565c0", "Test")]
title = re.sub(r"^\[[^\]]+\]\s*", "", subj)
colour, label = next(((c, l) for k, c, l in KIND if title.startswith(k)), ("#455a64", "Notice"))
title = re.sub(r"^(?:PROBLEM|STILL WRONG|RESOLVED|OVERNIGHT|daily):\s*", "", title) or title
SECTION = {"New problems": "#c62828", "Still wrong": "#ef6c00", "Resolved": "#2e7d32", "Open problems": "#ef6c00",
           "During quiet hours": "#546e7a"}


def para(text, size=14, colour_="#263238", top=0, bottom=12, bold=False):
    return ('<tr><td style="%spadding:%dpx 24px %dpx 24px;font-size:%dpx;line-height:%dpx;color:%s;%s">%s</td></tr>'
            % (FONT, top, bottom, size, int(size * 1.5), colour_, "font-weight:bold;" if bold else "", text))


def card(text, c):
    return ('<tr><td style="padding:0 24px 8px 24px">'
            '<table role="presentation" width="100%%" cellpadding="0" cellspacing="0" border="0"><tr>'
            '<td width="4" bgcolor="%s" style="background:%s;width:4px;font-size:1px">&nbsp;</td>'
            '<td bgcolor="#f5f7f8" style="%sbackground:#f5f7f8;padding:10px 14px;font-size:14px;line-height:21px;color:#263238">%s</td>'
            '</tr></table></td></tr>' % (c, c, FONT, text))


rows_out, status = [], []
for b in [b.strip("\n") for b in re.split(r"\n\s*\n", body) if b.strip()]:
    lines = b.split("\n")
    head = next((k for k in SECTION if lines[0].startswith(k)), None)
    if head:
        c = SECTION[head]
        rows_out.append(para(e(lines[0].rstrip(":")), 15, c, 14, 8, True))
        rows_out += [card(e(x[2:] if x.startswith("- ") else x), c) for x in lines[1:] if x.strip()]
        continue
    kv = [re.match(r"^([A-Za-z][\w /-]{1,30}):\s+(.*)$", x) for x in lines]
    if all(kv):
        for m in kv:
            k, v = m.group(1), m.group(2)
            if k == "All current problems":
                n = v.strip()
                chip = "#2e7d32" if n == "0" else "#ef6c00"
                rows_out.append('<tr><td style="padding:12px 24px 4px 24px"><table role="presentation" cellpadding="0" cellspacing="0" border="0">'
                                '<tr><td bgcolor="%s" style="%sbackground:%s;color:#ffffff;padding:4px 12px;font-size:13px;font-weight:bold">'
                                'Open problems: %s</td></tr></table></td></tr>' % (chip, FONT, chip, e(n)))
            else:
                bad = re.search(r"FAILED|failed|(?<!no )under-voltage|[1-9]\d* rejected", v)
                status.append('<tr><td valign="top" style="%spadding:6px 16px 6px 0;font-size:14px;color:#607d8b;white-space:nowrap">%s</td>'
                              '<td valign="top" style="%spadding:6px 0;font-size:14px;line-height:20px;color:%s">%s</td></tr>'
                              % (FONT, e(k), FONT, "#c62828" if bad else "#263238", e(v)))
        continue
    rows_out.append(para(e(b).replace("\n", "<br>"), top=4))
if status:
    rows_out.append(para("Pi status", 15, "#37474f", 18, 6, True))
    rows_out.append('<tr><td style="padding:0 24px 16px 24px"><table role="presentation" cellpadding="0" cellspacing="0" border="0">%s</table></td></tr>'
                    % "".join(status))
print(
    '<!doctype html><html><head><meta charset="utf-8"></head><body style="margin:0;padding:0;background:#eceff1">'
    '<table role="presentation" width="100%%" cellpadding="0" cellspacing="0" border="0" bgcolor="#eceff1" style="background:#eceff1">'
    '<tr><td align="center" style="padding:16px 8px">'
    '<table role="presentation" width="640" cellpadding="0" cellspacing="0" border="0" bgcolor="#ffffff" style="width:640px;background:#ffffff">'
    '<tr><td bgcolor="%s" style="%sbackground:%s;padding:16px 24px">'
    '<div style="font-size:12px;line-height:16px;color:#ffffff;text-transform:uppercase;letter-spacing:1px">%s</div>'
    '<div style="font-size:18px;line-height:24px;color:#ffffff;font-weight:bold">%s</div></td></tr>'
    '<tr><td style="font-size:1px;line-height:12px">&nbsp;</td></tr>'
    '%s'
    '<tr><td style="%spadding:12px 24px 18px 24px;font-size:12px;line-height:18px;color:#90a4ae;border-top:1px solid #eceff1">'
    'FindPitches Pi health alerts &middot; quiet 22:00&ndash;07:00 (held, then sent) &middot; details on the Pi: '
    'sudo fpd-alert-check --show</td></tr>'
    '</table></td></tr></table></body></html>'
    % (colour, FONT, colour, e(label), e(title), "".join(rows_out), FONT))
PY
}

send() {  # send SUBJECT BODY -> 0 on confirmed acceptance
  local subj="[$HOST] $1" body tmp code
  if [[ ${FPD_ALERT_DRY_RUN:-0} == 1 ]]; then printf -- '--- DRY RUN email\nSubject: %s\n%s\n' "$subj" "$2"; return 0; fi
  [[ -n ${SMTP2GO_API_KEY:-} && -n ${ALERT_FROM:-} && -n ${ALERT_TO:-} ]] || { echo "fpd-alert: alert.env incomplete" >&2; return 1; }
  tmp=$(mktemp -d); body=$tmp/body.json
  local h; h=$(render_html "$subj" "$2" 2>/dev/null) || h=""
  jq -n --arg f "$ALERT_FROM" --arg t "$ALERT_TO" --arg s "$subj" --arg b "$2" --arg h "$h" \
    '{sender:$f, to:($t|split(",")|map(gsub("^\\s+|\\s+$";""))), subject:$s, text_body:$b}
     + (if $h == "" then {} else {html_body:$h} end)' > "$body"
  code=$(printf 'header = "X-Smtp2go-Api-Key: %s"\n' "$SMTP2GO_API_KEY" | \
    curl -sS --max-time 25 -K - -H 'Content-Type: application/json' --data-binary @"$body" -o "$tmp/resp" -w '%{http_code}' \
    https://api.smtp2go.com/v3/email/send 2>"$tmp/err")
  if [[ $code == 200 ]] && jq -e '(.data.succeeded // 0) >= 1 and (.data.failed // 0) == 0' "$tmp/resp" >/dev/null 2>&1; then
    echo "fpd-alert: sent \"$subj\""; rm -rf "$tmp"; return 0
  fi
  echo "fpd-alert: SEND FAILED http=$code $(jq -c '{error_code:.data.error_code,error:.data.error,failures:.data.failures}' "$tmp/resp" 2>/dev/null || head -c 200 "$tmp/err" | clean)" >&2
  rm -rf "$tmp"; return 1
}

case $MODE in
  --show) P=$(problems); [[ -z $P ]] && echo "no problems" || echo "$P" | sed 's/\t/: /'; summary; exit 0 ;;
  --test) send "test alert: email alerts are working" "This is a test from fpd-alert-check on $HOST. You will get an email when something goes wrong, a reminder every 6 hours while it stays wrong, one when it is fixed, and a daily summary around ${ALERT_DAILY_HOUR}:00. If the daily summary stops arriving, the Pi itself is down or offline.

$(summary)"; exit $? ;;
  check) ;;
  *) echo "usage: fpd-alert-check [--test|--show]" >&2; exit 2 ;;
esac

# ------------------------------------------------------------------ decide what to send
P=$(problems)
CUR=$(printf '%s\n' "$P" | jq -Rn '[inputs|select(length>0)|split("\t")|{key:.[0],value:(.[1:]|join(" "))}]|from_entries')
S=$(cat "$STATE")
BOOT=$(cat "${FPD_BOOT_ID_FILE:-/proc/sys/kernel/random/boot_id}" 2>/dev/null || echo unknown)
NEW=$(jq -r --argjson c "$CUR" '.active as $a | $c|to_entries|map(select($a[.key]==null))|.[]|"- \(.value)"' <<<"$S")
DUE=$(jq -r --argjson c "$CUR" --argjson now "$NOW" --argjson rep "$REPEAT_S" '.active as $a | $c|to_entries|map(select($a[.key]!=null and ($now-$a[.key].last_sent)>=$rep))|.[]|"- \(.value) (since \($a[.key].since|todate))"' <<<"$S")
GONE=$(jq -r --argjson c "$CUR" '.active|to_entries|map(select($c[.key]==null))|.[]|"- \(.value.msg)"' <<<"$S")
REBOOT=""; PREV_BOOT=$(jq -r .boot <<<"$S"); [[ -n $PREV_BOOT && $PREV_BOOT != "$BOOT" ]] && REBOOT="The Pi restarted (booted $(uptime -s 2>/dev/null)). If you did not restart it, suspect a power cut or the power supply."
DAILY=""; TODAY=$(date -d "@$NOW" +%F); HOUR=$(date -d "@$NOW" +%-H)
[[ $HOUR -ge $ALERT_DAILY_HOUR && $(jq -r .daily <<<"$S") != "$TODAY" ]] && DAILY=1
if [[ $ALERT_QUIET =~ ^([0-9]{1,2})-([0-9]{1,2})$ ]]; then
  QS=$((10#${BASH_REMATCH[1]})); QE=$((10#${BASH_REMATCH[2]}))
  if (( QS != QE )) && { (( QS > QE && (HOUR >= QS || HOUR < QE) )) || (( QS < QE && HOUR >= QS && HOUR < QE )); }; then
    # quiet hours: send nothing; remember what was seen so the first email afterwards reports it (even if it cleared)
    jq --argjson c "$CUR" --argjson now "$NOW" '.overnight = ((.overnight // {}) as $o
        | $o + ($c|with_entries(.key as $k | .value = {msg:.value, first:($o[$k].first // $now), last:$now})))' <<<"$S" > "$STATE.tmp" && mv "$STATE.tmp" "$STATE"
    [[ -n $NEW || -n $GONE || -n $REBOOT ]] && echo "fpd-alert: quiet hours ($ALERT_QUIET); holding email until ${QE}:00"
    exit 0
  fi
fi
OVER=$(jq -r --argjson c "$CUR" '.active as $a | (.overnight // {})|to_entries|map(select($c[.key]==null and $a[.key]==null))
  |.[]|"- \(.value.msg) (seen \(.value.first|strflocaltime("%H:%M"))-\(.value.last|strflocaltime("%H:%M")))"' <<<"$S")

SENT_HOUR=$(jq --argjson now "$NOW" '[.sent[]|select(.>($now-3600))]|length' <<<"$S")
subject=""; body=""
if [[ -n $NEW || -n $REBOOT ]]; then
  n=$(jq 'length' <<<"$CUR")
  subject="PROBLEM: $(printf '%s\n' "$NEW" | head -1 | sed 's/^- //' | cut -c1-70)$( [[ $n -gt 1 ]] && echo " (+$((n-1)) more)")"
  [[ -z $NEW ]] && subject="Pi restarted"
fi
[[ -z $subject && -n $DUE ]] && subject="STILL WRONG: $(printf '%s\n' "$DUE" | head -1 | sed 's/^- //' | cut -c1-70)"
[[ -z $subject && -n $GONE ]] && subject="RESOLVED: $(printf '%s\n' "$GONE" | head -1 | sed 's/^- //' | cut -c1-70)"
[[ -z $subject && -n $OVER ]] && subject="OVERNIGHT: $(printf '%s\n' "$OVER" | wc -l) problem(s) came and went during quiet hours"
if [[ -n $subject ]]; then
  body="${REBOOT:+$REBOOT

}${NEW:+New problems:
$NEW

}${DUE:+Still wrong:
$DUE

}${GONE:+Resolved:
$GONE

}${OVER:+During quiet hours (already cleared, not emailed at the time):
$OVER

}All current problems: $(jq 'length' <<<"$CUR")
$(summary)"
elif [[ -n $DAILY ]]; then
  if [[ $(jq length <<<"$CUR") -eq 0 ]]; then subject="daily: all OK"; else subject="daily: $(jq length <<<"$CUR") open problem(s)"; fi
  body="Daily summary. If this email stops arriving, the Pi is down, offline or its alerting has stopped.

$( [[ $(jq length <<<"$CUR") -gt 0 ]] && printf 'Open problems:\n%s\n\n' "$(jq -r 'to_entries[]|"- \(.value)"' <<<"$CUR")")$(summary)"
fi

ok=1
if [[ -n $subject ]]; then
  if [[ $SENT_HOUR -ge $MAX_PER_HOUR ]]; then echo "fpd-alert: rate limit ($MAX_PER_HOUR/hour) reached; will retry next run" >&2; ok=0
  else send "$subject" "$body" || ok=0; fi
fi

# ------------------------------------------------------------------ persist state (only advance what was actually sent)
if [[ $ok == 1 ]]; then
  jq --argjson c "$CUR" --argjson now "$NOW" --argjson rep "$REPEAT_S" --arg boot "$BOOT" --arg today "$TODAY" \
     --arg sent "$([[ -n $subject ]] && echo 1)" --arg daily "$DAILY" --arg main "$([[ -n $NEW || -n $DUE || -n $GONE || -n $REBOOT || -n $OVER ]] && echo 1)" '
    .active as $a
    | .active = ($c|to_entries|map(.key as $k | {key:$k, value:{msg:.value,
          since:($a[$k].since // $now),
          last_sent:(if $a[$k]==null or ($now-$a[$k].last_sent)>=$rep then (if $main=="1" then $now else ($a[$k].last_sent // 0) end) else $a[$k].last_sent end)}})|from_entries)
    | .boot = $boot
    | (if $sent=="1" then .overnight = {} else . end)
    | (if $daily=="1" and $main=="" then .daily=$today else . end)
    | .sent = ([.sent[]|select(.>($now-3600))] + (if $sent=="1" then [$now] else [] end))' <<<"$S" > "$STATE.tmp" && mv "$STATE.tmp" "$STATE"
else
  # nothing confirmed sent: keep previous state but remember the boot so a reboot notice is retried, not lost
  :
fi
exit 0
