#!/usr/bin/env bash
# The V3 runner keeps a private copy of every export it sends (~6 MB each). Keep the newest 6 copies and
# 30 days of checkpoints (always at least the newest 20). Runs as user fpdv3.
set -euo pipefail
S=/srv/fpd/delivery/state
# (2026-10-12) Fixed: with pipefail, an empty glob (ls exit 2) or a final non-matching "[[ ]] &&" test (exit 1) used to
# fail the whole unit once more than 20 checkpoints existed, none older than 30 days.
shopt -s nullglob
exports=("$S"/exports/*.json)
if (( ${#exports[@]} > 6 )); then ls -1t -- "${exports[@]}" | tail -n +7 | xargs -r -d '\n' rm -f --; fi
checkpoints=("$S"/checkpoints/*.json)
if (( ${#checkpoints[@]} > 20 )); then
  ls -1t -- "${checkpoints[@]}" | tail -n +21 | while read -r f; do
    if [[ -n $(find "$f" -mtime +30 -print) ]]; then rm -f -- "$f"; fi
  done
fi
find "$S" -name '*.tmp' -mmin +120 -delete 2>/dev/null || true
echo "pruned: $(ls "$S"/exports 2>/dev/null | wc -l) export copies, $(ls "$S"/checkpoints 2>/dev/null | wc -l) checkpoints kept"
