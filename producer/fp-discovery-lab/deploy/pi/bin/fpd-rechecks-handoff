#!/usr/bin/env bash
# Runs as root just before each discovery cycle (ExecStartPre=+ in fpd-acquire.service).
# Passes V3's recheck requests from the delivery user's state to the discovery user. Only producer ids,
# timestamps and reasons cross over; the delivery state (and the token) stay out of reach of user fpd.
set -euo pipefail
SRC=/srv/fpd/delivery/state/rechecks.json
DST=/srv/fpd/data/inbox
install -d -m 0750 -o fpd -g fpd "$DST"
[[ -s "$SRC" ]] || { echo "no recheck requests file yet"; exit 0; }
TMP=$(mktemp "$DST/.rechecks.XXXXXX")
jq '{requested_at, requests: [.requests[]? | {producer_record_id, requested_at, reason}]}' "$SRC" > "$TMP"
chown fpd:fpd "$TMP"; chmod 0640 "$TMP"; mv -f "$TMP" "$DST/rechecks.json"
echo "handed over $(jq '.requests | length' "$DST/rechecks.json") recheck requests"
