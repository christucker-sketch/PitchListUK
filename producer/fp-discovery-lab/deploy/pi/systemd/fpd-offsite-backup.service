[Unit]
Description=FindPitches off-site backup (DB + kit + non-secret config to rclone remote fpdoffsite)
Wants=network-online.target
After=network-online.target fpd-backup.service
RequiresMountsFor=/srv/fpd
ConditionPathExists=/etc/fpd/rclone.conf

[Service]
Type=oneshot
ExecStart=/opt/fpd/bin/fpd-offsite-backup
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=2h
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/srv/fpd/backups /etc/fpd
