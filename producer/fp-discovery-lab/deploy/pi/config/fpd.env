# Discovery engine settings (no secrets here). Read by fpd-acquire.service and fpd-backup.service.
FPD_DATA_DIR=/srv/fpd/data
FPD_EXPORT_DIR=/srv/fpd/export
# Pi 3 has 1 GB RAM: keep parallelism low (per-host politeness is unchanged).
FPD_CONCURRENCY=8
# Contact added to the crawler User-Agent. Set to an email address or URL you are happy to publish.
FPD_CONTACT=
# Minutes per cycle: platform polling, then revisits/organiser crawl.
FPD_RUN_MINUTES=35
FPD_CRAWL_MINUTES=10
TLDEXTRACT_CACHE=/srv/fpd/data/.tldextract
PYTHONDONTWRITEBYTECODE=1
