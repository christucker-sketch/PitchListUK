{
  "name": "pitchlist-uk-site",
  "version": "0.1.0",
  "private": true,
  "description": "Static public landing page for PitchList UK.",
  "scripts": {
    "build": "node scripts/build.js",
    "check": "node scripts/check.js && node --test tests/*.test.mjs",
    "test:pipeline": "node --test operations/opportunity-pipeline/tests/*.test.js",
    "staging:discover": "node operations/opportunity-pipeline/scripts/grow-database.js",
    "staging:fetch-approved": "node operations/opportunity-pipeline/scripts/fetch-approved-sources.js",
    "staging:review": "node operations/opportunity-pipeline/scripts/clean-staged-events.js",
    "staging:manifest-approved-additions": "node scripts/build-automatic-addition-manifest.js",
    "staging:refresh": "node operations/opportunity-pipeline/scripts/refresh-active-events.js",
    "staging:health": "node operations/opportunity-pipeline/scripts/health-check.js",
    "staging:texas-approved": "node operations/opportunity-pipeline/scripts/run-texas-approved-staging.js",
    "staging:texas-promotion": "node operations/opportunity-pipeline/scripts/build-texas-promotion-manifest.js",
    "staging:texas-production-preview": "node operations/opportunity-pipeline/scripts/preview-texas-production-apply.js",
    "staging:texas-production-publish": "node operations/opportunity-pipeline/scripts/publish-texas-production.js",
    "sources:discover": "node operations/opportunity-pipeline/scripts/discover-source-candidates.js",
    "sources:manifest": "node operations/opportunity-pipeline/scripts/build-source-promotion-manifest.js",
    "sources:promote": "node operations/opportunity-pipeline/scripts/apply-source-promotion-manifest.js",
    "deploy:production": "node scripts/deploy-public-site.js",
    "publish:opportunities": "node scripts/publish-reviewed-opportunities.js",
    "revalidate:reviewed-additions": "node scripts/revalidate-reviewed-additions.js",
    "data:export": "node scripts/export-opportunities.js"
  },
  "devDependencies": {}
}
